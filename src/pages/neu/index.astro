---
/**
 * App-Log: was in der Club Ludwig App neu ist – und ein Ausblick.
 * Einträge stehen in src/data/app-log.json (siehe README).
 */
import AppLayout from '../../layouts/AppLayout.astro';
import { app, site } from '../../config/site';
import AppLogEntry from '../../components/AppLogEntry.astro';
import { shipped, upcoming } from '../../lib/app-log';
---

<AppLayout
  title={`Was neu ist – ${app.name}`}
  description="Die letzten Änderungen der Club Ludwig App, was als Nächstes kommt – und ab und zu ein kleiner Leak."
>
  <main class="log">
    <a class="log__back" href="/">
      <img src="/assets/logo-white.png" alt={site.name} width="660" height="136" />
    </a>

    <h1 class="log__title">Was in der App passiert</h1>
    <p class="log__lead">
      Die letzten Änderungen, was als Nächstes kommt – und ab und zu ein kleiner Leak.
    </p>

    {
      upcoming.length > 0 && (
        <section class="log__section" aria-labelledby="ausblick">
          <h2 id="ausblick" class="log__heading">Ausblick</h2>
          <ol class="log__list">
            {upcoming.map((e) => <AppLogEntry entry={e} showTag />)}
          </ol>
        </section>
      )
    }

    {
      shipped.length > 0 && (
        <section class="log__section" aria-labelledby="log">
          <h2 id="log" class="log__heading">Log</h2>
          <ol class="log__list">
            {shipped.map((e) => <AppLogEntry entry={e} />)}
          </ol>
        </section>
      )
    }

    <a class="log__cta" href={app.testflight}>App bei TestFlight holen ↗</a>
  </main>
</AppLayout>

<script>
  // Wer weniger Bewegung eingestellt hat, sieht das Standbild statt der Loops.
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<HTMLVideoElement>('.entry__video').forEach((v) => {
      v.removeAttribute('autoplay');
      v.pause();
      v.currentTime = 0;
    });
  }
</script>

<style>
  .log {
    flex: 1;
    width: 100%;
    max-width: 680px;
    margin: 0 auto;
    padding: 48px 16px 32px;
  }

  .log__back img {
    display: block;
    width: 150px;
    height: auto;
    margin-bottom: 40px;
  }

  .log__title {
    margin: 0;
    font-size: clamp(30px, 5vw, 44px);
    line-height: 1.05;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .log__lead {
    margin: 14px 0 0;
    color: var(--cream-72);
    font-size: 17px;
    line-height: 1.55;
  }

  .log__section {
    margin-top: 48px;
  }

  .log__heading {
    margin: 0 0 16px;
    color: var(--cream-55);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .log__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }

  .log__cta {
    display: inline-block;
    margin-top: 40px;
    padding: 14px 24px;
    border-radius: var(--radius-sm);
    background: var(--color-lime);
    color: var(--color-night);
    font-weight: 700;
    text-decoration: none;
  }
</style>
