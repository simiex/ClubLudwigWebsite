---
/**
 * App-Log: was in der Club Ludwig App neu ist – und ein Ausblick.
 * Einträge stehen in src/data/app-log.json (siehe README).
 */
import AppLayout from '../../layouts/AppLayout.astro';
import { app, site } from '../../config/site';
import { formatLogDate, shipped, upcoming, type AppLogKind } from '../../lib/app-log';

const labels: Record<AppLogKind, string> = { neu: 'Neu', bald: 'Bald', leak: 'Leak' };
---

<AppLayout
  title={`Was neu ist – ${app.name}`}
  description="Die letzten Änderungen der Club Ludwig App, was als Nächstes kommt – und ab und zu ein kleiner Leak."
>
  <main class="log">
    <a class="log__back" href="/">
      <img src="/assets/logo-white.png" alt={site.name} width="660" height="136" />
    </a>

    <h1 class="log__title">Was in der App passiert</h1>
    <p class="log__lead">
      Die letzten Änderungen, was als Nächstes kommt – und ab und zu ein kleiner Leak.
    </p>

    {
      upcoming.length > 0 && (
        <section class="log__section" aria-labelledby="ausblick">
          <h2 id="ausblick" class="log__heading">Ausblick</h2>
          <ol class="log__list">
            {upcoming.map((e) => (
              <li class={`entry entry--${e.kind}`}>
                <p class="entry__meta">
                  <span class="entry__tag">{labels[e.kind]}</span>
                  <time datetime={e.date}>{formatLogDate(e.date)}</time>
                </p>
                <h3 class="entry__title">{e.title}</h3>
                <p class="entry__text">{e.text}</p>
              </li>
            ))}
          </ol>
        </section>
      )
    }

    {
      shipped.length > 0 && (
        <section class="log__section" aria-labelledby="log">
          <h2 id="log" class="log__heading">Log</h2>
          <ol class="log__list">
            {shipped.map((e) => (
              <li class="entry entry--neu">
                <p class="entry__meta">
                  <time datetime={e.date}>{formatLogDate(e.date)}</time>
                </p>
                <h3 class="entry__title">{e.title}</h3>
                <p class="entry__text">{e.text}</p>
              </li>
            ))}
          </ol>
        </section>
      )
    }

    <a class="log__cta" href={app.testflight}>App bei TestFlight holen ↗</a>
  </main>
</AppLayout>

<style>
  .log {
    flex: 1;
    width: 100%;
    max-width: 680px;
    margin: 0 auto;
    padding: 48px 16px 32px;
  }

  .log__back img {
    display: block;
    width: 150px;
    height: auto;
    margin-bottom: 40px;
  }

  .log__title {
    margin: 0;
    font-size: clamp(30px, 5vw, 44px);
    line-height: 1.05;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .log__lead {
    margin: 14px 0 0;
    color: var(--cream-72);
    font-size: 17px;
    line-height: 1.55;
  }

  .log__section {
    margin-top: 48px;
  }

  .log__heading {
    margin: 0 0 16px;
    color: var(--cream-55);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .log__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }

  .entry {
    padding: 18px 20px;
    border: 1px solid var(--cream-line);
    border-radius: var(--radius);
    background: var(--color-surface-2);
  }

  .entry--bald {
    border-color: var(--lime-line);
  }

  .entry--leak {
    border-color: rgba(62, 240, 207, 0.3);
  }

  .entry__meta {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    color: var(--cream-55);
    font-size: 13px;
  }

  .entry__tag {
    padding: 2px 8px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: var(--color-lime);
    color: var(--color-night);
  }

  .entry--leak .entry__tag {
    background: var(--color-neon);
  }

  .entry__title {
    margin: 8px 0 0;
    font-size: 19px;
    font-weight: 700;
    line-height: 1.25;
  }

  .entry__text {
    margin: 6px 0 0;
    color: var(--cream-72);
    font-size: 15px;
    line-height: 1.55;
  }

  .log__cta {
    display: inline-block;
    margin-top: 40px;
    padding: 14px 24px;
    border-radius: var(--radius-sm);
    background: var(--color-lime);
    color: var(--color-night);
    font-weight: 700;
    text-decoration: none;
  }
</style>
