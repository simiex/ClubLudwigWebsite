---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Media from '../../../components/Media.astro';
import Kicker from '../../../components/Kicker.astro';
import { requireVenue } from '../../../data/venues';

const venue = requireVenue('hofgarten');
const komootUrl = 'https://www.komoot.com/de-DE/tour/3067886418?ref=itd&share_token=awmSVc7S6WEPw5KH1q3txk03G23PZmwMg86daWKD22XoX5nYRH&ref=its&t_s=referral&t_cid=route_share&t_ref_username=5426904744148';
---

<BaseLayout title="Hofgarten – Club Ludwig Standort Bonn" description="Club Ludwig im Bonner Hofgarten: zentraler Startpunkt für Urban Hikes, Community Walks und Feierabendtouren durch Bonn und am Rhein.">
  <section class="venue-hero">
    <div class="venue-hero__media" aria-hidden="true"><Media name={venue.media} alt="" eager /><div class="venue-hero__veil"></div><div class="venue-hero__grid"></div></div>
    <div class="venue-hero__inner"><div class="venue-hero__copy"><Kicker>Standort Hofgarten</Kicker><h1>Mitten in Bonn.<br /><span>Direkt ins Draußen.</span></h1><p class="venue-hero__lead">Unser urbanster Startpunkt: zentral, unkompliziert und gemacht für gemeinsame Kilometer nach Feierabend.</p><a class="btn btn--primary" href={venue.uscUrl} target="_blank" rel="noopener">Bei Urban Sports Club ansehen <span aria-hidden="true">↗</span></a></div></div>
    <div class="venue-hero__ticker" aria-label="Nächstes Event"><div>NÄCHSTES EVENT AM HOFGARTEN · 30.08.2026 · COMMUNITY HIKE DURCH BONN · NÄCHSTES EVENT AM HOFGARTEN · 30.08.2026 · COMMUNITY HIKE DURCH BONN ·</div></div>
  </section>

  <section class="route-stage" aria-labelledby="route-title">
    <div class="route-stage__inner">
      <div class="route-stage__map" aria-label="Stilisierte Darstellung der Komoot-Strecke auf der Bonner Rheinseite">
        <div class="district district--bonn">BONN</div><div class="district district--beuel">BEUEL</div><div class="river" aria-hidden="true"></div><div class="streets" aria-hidden="true"></div><div class="forest forest--venusberg" aria-hidden="true"></div><div class="forest forest--dottendorf" aria-hidden="true"></div>
        <svg class="route" viewBox="0 0 900 620" aria-hidden="true">
          <path class="route__shadow" d="M566 104 C548 126 536 151 538 176 C540 204 558 224 563 251 C569 283 548 304 529 329 C508 357 510 392 535 414 C555 431 571 447 564 471 C557 495 532 512 508 510 C473 507 463 474 439 453 C410 428 382 432 350 449 C314 468 270 480 235 464 C205 451 190 421 200 391 C212 355 249 330 268 300 C286 271 282 240 266 214 C248 184 236 154 251 127 C267 98 306 91 338 101 C374 112 402 138 429 160 C452 179 476 187 499 174 C522 161 532 134 542 114 C550 98 559 94 566 104" />
          <path class="route__line" pathLength="1" d="M566 104 C548 126 536 151 538 176 C540 204 558 224 563 251 C569 283 548 304 529 329 C508 357 510 392 535 414 C555 431 571 447 564 471 C557 495 532 512 508 510 C473 507 463 474 439 453 C410 428 382 432 350 449 C314 468 270 480 235 464 C205 451 190 421 200 391 C212 355 249 330 268 300 C286 271 282 240 266 214 C248 184 236 154 251 127 C267 98 306 91 338 101 C374 112 402 138 429 160 C452 179 476 187 499 174 C522 161 532 134 542 114 C550 98 559 94 566 104" />
        </svg>
        <div class="pin pin--start"><span></span><strong>START</strong><small>Hofgarten</small></div><div class="pin pin--forest"><span></span><strong>VENUSBERG</strong><small>Waldschleifen</small></div><div class="pin pin--south"><span></span><strong>DOTTENDORF</strong><small>Südlicher Bogen</small></div><div class="pin pin--rhein"><span></span><strong>RHEIN</strong><small>Bonner Ufer</small></div>
      </div>
      <div class="route-stage__copy"><Kicker class="route-kicker">Stadtstart</Kicker><h2 id="route-title">Bonn wird<br />zur Route.</h2><p>Die Strecke bleibt vollständig auf der Bonner Rheinseite: vom Hofgarten nach Süden, in die grünen Höhen rund um Venusberg und Dottendorf und anschließend am Rheinufer zurück.</p><dl><div><dt>Treffpunkt</dt><dd>Hofgarten, Bonn</dd></div><div><dt>Distanz</dt><dd>21,3 km</dd></div><div><dt>Höhenmeter</dt><dd>250 hm</dd></div><div><dt>Anmeldung</dt><dd><a href={venue.uscUrl} target="_blank" rel="noopener">Urban Sports Club ↗</a><a href={komootUrl} target="_blank" rel="noopener">Komoot-Strecke ↗</a></dd></div></dl></div>
    </div>
  </section>

  <section class="venue-cta"><div class="venue-cta__inner"><div><Kicker>Nächster Schritt</Kicker><h2>Beim nächsten<br /><span>Stadtstart dabei.</span></h2></div><div class="venue-cta__actions"><p>Alle aktuellen Termine, Plätze und Buchungsdetails findest du direkt bei Urban Sports Club.</p><a class="btn btn--primary" href={venue.uscUrl} target="_blank" rel="noopener">Hofgarten bei USC öffnen <span aria-hidden="true">↗</span></a><a class="venue-cta__back" href="/#regionen">← Alle Standorte</a></div></div></section>
</BaseLayout>

<style>
.venue-hero{position:relative;min-height:100svh;overflow:hidden;background:var(--color-night-deep)}.venue-hero__media,.venue-hero__media :global(.media){position:absolute;inset:0}.venue-hero__media :global(img),.venue-hero__media :global(svg){width:100%;height:100%;object-fit:cover}.venue-hero__veil{position:absolute;inset:0;background:linear-gradient(90deg,rgba(3,8,14,.96),rgba(3,8,14,.72) 48%,rgba(3,8,14,.28)),linear-gradient(0deg,rgba(3,8,14,.92),transparent 58%)}.venue-hero__grid{position:absolute;inset:0;opacity:.12;background-image:linear-gradient(rgba(219,255,62,.3) 1px,transparent 1px),linear-gradient(90deg,rgba(219,255,62,.3) 1px,transparent 1px);background-size:72px 72px;mask-image:linear-gradient(90deg,#000,transparent 78%)}.venue-hero__inner{position:relative;z-index:2;min-height:100svh;max-width:var(--max-width-content);margin:auto;padding:180px var(--pad-x) 130px;display:flex;align-items:flex-end}.venue-hero :global(.kicker),.venue-cta :global(.kicker){color:var(--color-lime)}.venue-hero__copy{max-width:940px}h1{margin:22px 0 0;font-size:clamp(58px,9.2vw,150px);line-height:.86;letter-spacing:-.055em}h1 span,.venue-cta h2 span{color:var(--color-lime)}.venue-hero__lead{max-width:57ch;margin:34px 0 38px;color:var(--cream-80);font-size:clamp(17px,1.5vw,21px);line-height:1.65}.venue-hero__ticker{position:absolute;z-index:3;left:0;right:0;bottom:0;overflow:hidden;border-top:1px solid rgba(219,255,62,.24);background:rgba(3,8,14,.84);color:var(--color-lime)}.venue-hero__ticker div{width:max-content;padding:18px 0;font-size:12px;font-weight:700;letter-spacing:.22em;animation:ticker 30s linear infinite}@keyframes ticker{to{transform:translateX(-50%)}}
.route-stage{padding:132px var(--pad-x);background:var(--color-night)}.route-stage__inner,.venue-cta__inner{max-width:var(--max-width-content);margin:auto}.route-stage__inner{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(320px,.8fr);gap:86px;align-items:center}.route-stage__map{position:relative;min-height:650px;overflow:hidden;border:1px solid rgba(219,255,62,.24);border-radius:var(--radius);background:radial-gradient(circle at 27% 69%,rgba(77,116,72,.24),transparent 28%),radial-gradient(circle at 48% 82%,rgba(77,116,72,.16),transparent 24%),linear-gradient(145deg,#0b1520,#060d16 58%,#0b151b);box-shadow:0 28px 90px rgba(0,0,0,.36)}.streets{position:absolute;inset:-10%;opacity:.14;background-image:linear-gradient(28deg,transparent 46%,rgba(242,238,228,.35) 47% 48%,transparent 49%),linear-gradient(112deg,transparent 47%,rgba(242,238,228,.24) 48% 49%,transparent 50%),linear-gradient(164deg,transparent 48%,rgba(242,238,228,.16) 49% 50%,transparent 51%);background-size:84px 74px,118px 92px,142px 110px;transform:rotate(-3deg)}.river{position:absolute;top:-12%;bottom:-10%;left:68%;width:105px;border-inline:1px solid rgba(219,255,62,.14);background:linear-gradient(90deg,rgba(46,101,126,.18),rgba(76,153,183,.38),rgba(46,101,126,.18));transform:rotate(-8deg)}.forest{position:absolute;border-radius:48% 52% 57% 43%;background:rgba(72,111,65,.16);filter:blur(1px)}.forest--venusberg{left:9%;bottom:14%;width:260px;height:270px}.forest--dottendorf{left:39%;bottom:5%;width:210px;height:170px}.district{position:absolute;z-index:1;font-weight:800;text-transform:uppercase;letter-spacing:.18em;color:rgba(242,238,228,.2);text-shadow:0 4px 22px rgba(0,0,0,.6)}.district--bonn{left:7%;top:13%;font-size:clamp(22px,3vw,38px)}.district--beuel{right:5%;top:19%;font-size:clamp(18px,2.4vw,30px)}.route{position:absolute;z-index:3;inset:0;width:100%;height:100%;fill:none}.route__shadow{stroke:rgba(0,0,0,.82);stroke-width:14;stroke-linecap:round;stroke-linejoin:round}.route__line{stroke:var(--color-lime);stroke-width:5;stroke-linecap:round;stroke-linejoin:round;stroke-dasharray:1;stroke-dashoffset:1;filter:drop-shadow(0 0 10px rgba(219,255,62,.8));animation:draw 5s cubic-bezier(.65,0,.35,1) infinite alternate}@keyframes draw{to{stroke-dashoffset:0}}.pin{position:absolute;z-index:4;display:grid;grid-template-columns:18px auto;column-gap:10px;align-items:center;color:var(--color-cream);text-shadow:0 2px 12px rgba(0,0,0,.75)}.pin span{grid-row:1/span 2;width:14px;height:14px;border:3px solid var(--color-night);border-radius:50%;background:var(--color-lime);box-shadow:0 0 0 5px rgba(219,255,62,.18),0 0 24px rgba(219,255,62,.7)}.pin strong{font-size:11px;letter-spacing:.16em}.pin small{color:var(--cream-65)}.pin--start{left:60%;top:12%}.pin--forest{left:19%;top:59%}.pin--south{left:48%;bottom:8%}.pin--rhein{left:62%;top:47%}.route-kicker{color:var(--color-lime)!important}.route-kicker :global(.kicker__sun){color:var(--color-lime)!important}.route-stage__copy h2,.venue-cta h2{margin:22px 0 0;font-size:clamp(46px,6.2vw,92px);line-height:.94;letter-spacing:-.045em}.route-stage__copy>p{margin:30px 0 0;color:var(--cream-72);font-size:18px;line-height:1.75}.route-stage dl{margin:44px 0 0;border-top:1px solid var(--cream-line)}.route-stage dl div{display:grid;grid-template-columns:120px 1fr;gap:24px;padding:18px 0;border-bottom:1px solid var(--cream-line)}.route-stage dt{color:var(--cream-45);font-size:11px;letter-spacing:.14em;text-transform:uppercase}.route-stage dd{margin:0;color:var(--cream-88);display:flex;flex-wrap:wrap;gap:12px 20px}.route-stage dd a{color:var(--color-lime);border-bottom:1px solid rgba(219,255,62,.35)}
.venue-cta{padding:110px var(--pad-x) 120px;background:var(--color-night-deep);border-top:1px solid var(--lime-line)}.venue-cta__inner{display:grid;grid-template-columns:1.2fr .8fr;gap:96px;align-items:end}.venue-cta__actions p{margin:0 0 28px;max-width:45ch;color:var(--cream-72);font-size:17px;line-height:1.7}.venue-cta__back{display:inline-block;margin-top:22px;color:var(--cream-55)}
@media(max-width:899px){.venue-hero__inner{padding:140px 24px 112px}.route-stage{padding:72px 24px 88px}.route-stage__inner,.venue-cta__inner{grid-template-columns:1fr;gap:58px}.route-stage__map{min-height:580px}.river{left:71%;width:82px}.district--beuel{right:2%;top:17%}.pin{transform:scale(.9);transform-origin:left center}.pin--start{left:55%;top:11%}.pin--forest{left:11%;top:60%}.pin--south{left:39%;bottom:8%}.pin--rhein{left:57%;top:47%}.venue-cta{padding:76px 24px 88px}}
@media(prefers-reduced-motion:reduce){.route__line,.venue-hero__ticker div{animation:none}.route__line{stroke-dashoffset:0}}
</style>
