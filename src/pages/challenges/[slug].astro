---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Kicker from '../../components/Kicker.astro';
import {
  loadChallenges,
  formatPeriod,
  formatAmount,
  phase,
  daysLeft,
} from '../../lib/challenges';

export async function getStaticPaths() {
  const challenges = await loadChallenges();
  return challenges.map((c) => ({ params: { slug: c.slug }, props: { challenge: c } }));
}

const { challenge: c } = Astro.props;
const zustand = phase(c);
const tage = daysLeft(c);
---

<BaseLayout title={`${c.title} – Challenge | Club Ludwig`} description={c.description.slice(0, 155)}>
  <section class="cd">
    <div class="cd__inner">
      <a class="cd__back link-underline" href="/challenges/">Alle Challenges</a>

      <header class="cd__head">
        <Kicker class="cd__kicker" animated>
          {zustand === 'laufend' ? `Läuft – noch ${tage} Tage` : zustand === 'kommend' ? 'Kommt bald' : 'Beendet'}
        </Kicker>
        <h1>{c.title}</h1>
        {c.subtitle && <p class="cd__sub">{c.subtitle}</p>}
        <p class="cd__period">{formatPeriod(c)}</p>
        <p class="cd__desc">{c.description}</p>
      </header>

      <div class="cd__cta">
        <p class="cd__cta-text">
          {zustand === 'vorbei'
            ? 'Diese Challenge ist beendet.'
            : 'Mitmachen, Kilometer eintragen und deinen Stand sehen kannst du in deinem Bereich.'}
        </p>
        {zustand !== 'vorbei' && (
          <a class="btn btn--primary" href="/mein-club/#challenges">In meinen Bereich</a>
        )}
        <a class="link-underline cd__alt" href="/challenges/">Alle Challenges</a>
      </div>

      <ul class="facts">
        <li>
          <span class="facts__label">Ziel</span>
          <span class="facts__value">{formatAmount(c.goal, c.metric)}</span>
        </li>
        <li>
          <span class="facts__label">Zeitraum</span>
          <span class="facts__value">{formatPeriod(c)}</span>
        </li>
        {c.awards_stamp && (
          <li>
            <span class="facts__label">Belohnung</span>
            <span class="facts__value">Ein Stempel fürs Heft</span>
          </li>
        )}
        <li>
          <span class="facts__label">Nachweis</span>
          <span class="facts__value">Screenshot aus Komoot, Strava oder Health</span>
        </li>
      </ul>

    </div>
  </section>
</BaseLayout>

<style>
  .cd {
    background:
      radial-gradient(60% 40% at 25% 0%, rgba(62, 240, 207, 0.09) 0%, transparent 60%),
      var(--color-night);
    color: var(--color-cream);
    padding: 200px var(--pad-x) 128px;
    min-height: 100vh;
  }

  .cd__inner {
    max-width: 780px;
    margin: 0 auto;
  }

  .cd__back {
    font-size: 14px;
    font-weight: 600;
    color: var(--cream-55);
  }

  .cd__head {
    margin-top: 32px;
  }

  h1 {
    margin: 18px 0 0;
    font-size: clamp(34px, 4.6vw, 64px);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .cd__sub {
    margin: 12px 0 0;
    font-size: 18px;
    font-weight: 600;
    color: var(--color-neon);
  }

  .cd__period {
    margin: 14px 0 0;
    font-size: 13px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--cream-55);
  }

  .cd__desc {
    margin: 24px 0 0;
    font-size: 16px;
    line-height: 1.7;
    color: var(--cream-72);
  }

  .cd__cta {
    display: flex;
    align-items: center;
    gap: 24px;
    margin-top: 44px;
    padding: 28px 32px;
    background: var(--color-surface-2);
    border: 1px solid rgba(219, 255, 62, 0.32);
    border-radius: var(--radius);
    flex-wrap: wrap;
  }

  .cd__cta-text {
    flex: 1;
    min-width: 240px;
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--cream-72);
  }

  .cd__alt {
    font-size: 14px;
    font-weight: 600;
    color: var(--cream-55);
  }

  .facts {
    list-style: none;
    margin: 40px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 24px 32px;
  }

  .facts li {
    padding-top: 18px;
    border-top: 1px solid var(--cream-line);
  }

  .facts__label {
    display: block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--cream-45);
  }

  .facts__value {
    display: block;
    margin-top: 8px;
    font-size: 16px;
    font-weight: 600;
  }

  @media (max-width: 899px) {
    .cd {
      padding: 140px 24px 72px;
    }

    .cd__cta {
      padding: 22px;
    }

    .cd__cta .btn {
      width: 100%;
      text-align: center;
    }
  }
</style>
