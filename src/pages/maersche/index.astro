---
/**
 * Der Marschkalender im Marschpass-Design – zugleich die Seite, über die
 * Leute bei Google auf die App stoßen sollen („Märsche in meiner Nähe“,
 * „Wanderevents 2026“, „24-Stunden-Wanderung“).
 *
 * Die App verlinkt diese Adresse (KALENDER_URL), der Newsletter ebenso – sie
 * bleibt deshalb /maersche/. Pro Region gibt es /maersche/<region>/
 * ([region].astro), die Kacheln oben führen dorthin.
 *
 * Für Google: schema.org-Events je Termin, BreadcrumbList, FAQPage.
 */
import MarschpassLayout from '../../layouts/MarschpassLayout.astro';
import StructuredData from '../../components/StructuredData.astro';
import KalenderKopf from '../../components/marschpass/KalenderKopf.astro';
import RegionenGitter from '../../components/marschpass/RegionenGitter.astro';
import MarschListe from '../../components/marschpass/MarschListe.astro';
import KalenderInDerApp from '../../components/marschpass/KalenderInDerApp.astro';
import Fragen from '../../components/marschpass/Fragen.astro';
import { social } from '../../config/site';
import { breadcrumbSchema, faqSchema, landName, loadKalender, marchSchema, regionOf } from '../../lib/kalender';

const termine = await loadKalender();
const site = Astro.site!;

const jahr = new Date().getFullYear();
const saison = `${jahr}/${String(jahr + 1).slice(2)}`;
const stand = new Date().toLocaleDateString('de-DE', { day: '2-digit', month: '2-digit', year: '2-digit' });

/* Ein paar echte Zahlen für den Text – aus den Daten, nicht ausgedacht. */
const veranstalter = [...new Set(termine.map((m) => m.organizer).filter((o) => o !== 'Club Ludwig'))];
const grosse = [...termine.reduce((map, m) => map.set(m.organizer, (map.get(m.organizer) ?? 0) + 1), new Map<string, number>())]
  .filter(([o]) => o !== 'Club Ludwig')
  .sort((a, b) => b[1] - a[1])
  .slice(0, 3)
  .map(([o]) => o);
const distanzen = termine.flatMap((m) => m.distances_km);
const kuerzeste = distanzen.length ? Math.min(...distanzen) : null;
const laengste = distanzen.length ? Math.max(...distanzen) : null;
const anderesAusland = [...new Set(termine.filter((m) => !regionOf(m) && m.country !== 'DE').map((m) => landName(m.country)))];

const fragen = [
  {
    frage: 'Wie finde ich Märsche und Wanderevents in meiner Nähe?',
    antwort:
      'Wähl oben dein Bundesland. Jede Region hat eine eigene Seite mit allen Terminen dort und dazu den Terminen aus den angrenzenden Bundesländern. In der Club-Ludwig-App merkt sich der Kalender deine Region, sodass du sie nicht jedes Mal neu wählen musst.',
  },
  {
    frage: 'Was ist ein Marsch – und was ein 24-Stunden-Marsch?',
    antwort:
      'Ein Marsch ist eine organisierte Langstreckenwanderung mit festgelegter Strecke, Verpflegungspunkten und meist einem Zeitlimit. Beim 24-Stunden-Format läufst du so weit, wie du in einem Tag und einer Nacht kommst. Beim Backyard-Format läuft man jede volle Stunde dieselbe Runde – wer zu spät zurück ist, scheidet aus.',
  },
  {
    frage: 'Wie lang sind die Märsche im Kalender?',
    antwort:
      kuerzeste != null && laengste != null
        ? `Die Distanzen reichen gerade von ${kuerzeste} bis ${laengste} Kilometern. Viele Veranstaltungen bieten mehrere Strecken an – du kannst die Liste oben nach Distanz filtern.`
        : 'Von kurzen Wanderungen bis zu Ultramärschen über 100 Kilometer. Viele Veranstaltungen bieten mehrere Strecken an – du kannst die Liste nach Distanz filtern.',
  },
  {
    frage: 'Kann ich mich über Club Ludwig anmelden?',
    antwort:
      'Nein. Wir sammeln die Termine nur. Anmeldung und Startgebühr laufen immer beim Veranstalter – der Link am Termin führt direkt dorthin. Prüf Datum, Distanzen und Preise vor der Anmeldung dort.',
  },
  {
    frage: 'Was kostet der Marschkalender?',
    antwort:
      'Nichts – weder hier noch in der App. Die Club-Ludwig-App ist kostenlos für iPhone und Android. Dort kannst du Märsche vormerken, als gebucht markieren und eigene Termine eintragen.',
  },
  {
    frage: 'Ein Termin fehlt oder stimmt nicht?',
    antwort:
      'Trag ihn in der App selbst ein, dann sehen wir ihn und nehmen ihn in den Kalender auf. Oder schreib uns über Instagram. Wir pflegen den Kalender von Hand und übernehmen keine Gewähr für Termine, Distanzen oder Preise.',
  },
];

const schemas = [
  breadcrumbSchema(site),
  faqSchema(fragen),
  ...termine.filter((m) => m.status !== 'entwurf').map((m) => marchSchema(m, site)),
];
---

<MarschpassLayout
  title={`Märsche & Wanderevents in deiner Nähe ${saison} | Club Ludwig`}
  description={`${termine.length} Märsche, 24-Stunden-Wanderungen und Ultramärsche in Deutschland, Österreich und der Schweiz – nach Bundesland sortiert. Kostenlos, mit App zum Vormerken.`}
  aktiv="maersche"
>
  <StructuredData slot="head" schemas={schemas} />

  <KalenderKopf
    etikett={`Marschkalender · Stand ${stand}`}
    zeilen={['Märsche &', 'Wanderevents', 'in deiner Nähe.']}
    stempelZahl={termine.length}
    stempelUnten={saison}
  >
    <p>
      Megamarsch, Mammutmarsch, 24-Stunden-Wanderungen, Nachtmärsche: {termine.length} Termine von
      {' '}{veranstalter.length} Veranstaltern an einem Ort{grosse.length > 0 && <> – darunter {grosse.join(', ')}</>}.
      Wähl dein Bundesland, such dir eine Distanz aus, und der Link führt direkt zur Anmeldung.
    </p>
    <p>
      Mit der <a href="#app">Club-Ludwig-App</a> merkst du dir Märsche vor und siehst den nächsten
      Start auf einen Blick.
    </p>
  </KalenderKopf>

  <nav class="sprung" aria-label="Auf dieser Seite">
    <a class="sprung__link" href="#regionen">Nach Bundesland</a>
    <a class="sprung__link" href="#termine">Alle Termine</a>
    <a class="sprung__link sprung__link--app" href="#app">App laden</a>
  </nav>

  <section class="block" id="regionen" aria-labelledby="regionen-titel">
    <h2 class="block__titel" id="regionen-titel">Wo läufst du?</h2>
    <p class="block__text">
      Jedes Bundesland hat eine eigene Seite – mit den Terminen dort und in der Nachbarschaft.
    </p>
    <RegionenGitter termine={termine} />
    {
      anderesAusland.length > 0 && (
        <p class="block__fuss">
          Außerdem im Kalender: Termine in {anderesAusland.join(', ')} – unten in der Liste.
        </p>
      )
    }
  </section>

  <section class="block" id="termine" aria-labelledby="termine-titel">
    <h2 class="block__titel" id="termine-titel">Alle Termine {saison}</h2>
    {
      termine.length === 0 ? (
        <p class="block__text">Gerade sind keine Termine hinterlegt. Schau bald wieder vorbei.</p>
      ) : (
        <MarschListe termine={termine} filter ebene="h3" />
      )
    }
  </section>

  <KalenderInDerApp />

  <Fragen titel="Häufige Fragen" fragen={fragen} />

  <section class="fehlt" aria-labelledby="fehlt-titel">
    <h2 id="fehlt-titel">Termin fehlt?</h2>
    <p>
      Trag ihn in der App ein oder schreib uns – wir nehmen ihn auf. Lieber per Mail auf dem
      Laufenden? Der <a href="/newsletter/">Wochenmarsch</a> bringt dir montags die Märsche der Woche.
    </p>
    <a class="fehlt__link" href={social.instagram} target="_blank" rel="noopener">
      Über Instagram melden <span aria-hidden="true">↗</span>
    </a>
  </section>
</MarschpassLayout>

<style>
  .sprung {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 28px;
  }

  .sprung__link {
    padding: 10px 16px;
    border: 1.5px solid var(--tinte);
    border-radius: 999px;
    font-weight: 600;
    font-size: 15px;
    text-decoration: none;
    transition:
      translate 0.15s,
      box-shadow 0.15s;
  }

  .sprung__link:hover,
  .sprung__link:focus-visible {
    translate: -2px -2px;
    box-shadow: 3px 3px 0 var(--tinte);
  }

  .sprung__link--app {
    background: var(--glut);
    border-color: var(--glut);
    color: #fff;
  }

  .sprung__link--app:hover,
  .sprung__link--app:focus-visible {
    box-shadow: 3px 3px 0 var(--tinte);
  }

  .sprung__link:focus-visible {
    outline: 3px solid var(--glut);
    outline-offset: 3px;
  }

  .block {
    margin-top: clamp(48px, 8vw, 84px);
  }

  .block__titel {
    margin: 0;
    font-family: var(--f-titel);
    font-weight: 650;
    font-size: clamp(30px, 4.6vw, 52px);
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .block__text {
    max-width: 560px;
    margin: 12px 0 22px;
    color: var(--tinte-70);
  }

  .block__fuss {
    margin: 16px 0 0;
    color: var(--tinte-45);
    font-size: 15px;
  }

  .fehlt {
    margin-top: clamp(48px, 8vw, 84px);
    padding: clamp(22px, 4vw, 34px);
    border: 2px dashed var(--tinte-45);
    border-radius: 8px;
  }

  .fehlt h2 {
    margin: 0 0 8px;
    font-family: var(--f-titel);
    font-weight: 650;
    font-size: 28px;
    letter-spacing: -0.02em;
  }

  .fehlt p {
    max-width: 620px;
    margin: 0 0 16px;
    color: var(--tinte-70);
  }

  .fehlt a {
    color: var(--tinte);
    text-decoration-color: var(--glut);
    text-underline-offset: 3px;
  }

  .fehlt__link {
    font-weight: 600;
  }
</style>
