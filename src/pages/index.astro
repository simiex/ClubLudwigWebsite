---
/**
 * Startseite im Marschpass-Design der App: ein Weg, der sich selbst zeichnet,
 * und zwei Fahrkarten – eine in den App Store, eine zu Google Play.
 *
 * Kopf, Fuß, Paletten und Höhenlinien kommen aus dem MarschpassLayout, die
 * Fahrkarten aus components/marschpass – der Marschkalender nutzt dieselben.
 */
import MarschpassLayout from '../layouts/MarschpassLayout.astro';
import Fahrkarten from '../components/marschpass/Fahrkarten.astro';
import { app } from '../config/site';
import { SUN_PATH } from '../lib/sun';

const title = `${app.name} – jetzt für iPhone und Android`;
const description =
  'Club Ludwig, der Hiking Club aus Bonn, als App: Schritte, Tagesliga, Duelle und deine Serie. Jetzt im App Store und bei Google Play.';

/* Der Weg: von links unten über einen Hügel zur Sonne rechts. */
const WEG =
  'M40 230 C150 230 190 150 290 150 C390 150 400 210 500 200 C610 188 640 80 760 74 C860 69 900 140 990 130 C1060 122 1100 70 1150 60';
const ETAPPEN = [
  { x: 290, y: 150, label: '2.500' },
  { x: 500, y: 200, label: '5.000' },
  { x: 760, y: 74, label: '7.500' },
  { x: 990, y: 130, label: '9.000' },
];
---

<MarschpassLayout title={title} description={description} aktiv="start">
  <section class="held">
    <p class="etikett held__etikett reveal" style="--d: 0">
      <span class="punkt" aria-hidden="true"></span> Marschpass · Ausgabe 2026
    </p>
    <h1 class="held__titel">
      <span class="zeile reveal" style="--d: 1">Jeder Schritt</span>
      <span class="zeile reveal" style="--d: 2">zählt. <em>Jetzt auch</em></span>
      <span class="zeile reveal" style="--d: 3"><em>auf Android.</em></span>
    </h1>
    <p class="held__text reveal" style="--d: 4">
      Die App des Hiking Clubs aus Bonn: Tagesliga, Duelle, deine Serie und eine Weltreise, die
      wir zusammen laufen. Kostenlos für iPhone und Android.
    </p>

    <div class="stempel" aria-hidden="true">
      <span>Neu</span>
      <strong>Android</strong>
      <span>06·11·26</span>
    </div>
  </section>

  <figure class="weg" aria-hidden="true">
    <svg viewBox="0 0 1200 270" class="weg__svg">
      <path class="weg__spur" d={WEG} />
      <path class="weg__linie" d={WEG} pathLength="1000" />
      {
        ETAPPEN.map((e, i) => (
          <g class="etappe" style={`--i: ${i}`} transform={`translate(${e.x} ${e.y})`}>
            <circle r="9" />
            <text y="-20">{e.label}</text>
          </g>
        ))
      }
      <g class="weg__start" transform="translate(40 230)">
        <circle r="6" />
        <text y="30">START</text>
      </g>
      <g class="weg__sonne">
        <circle class="weg__schein" r="44" />
        <g class="weg__drehen">
          <path d={SUN_PATH} transform="translate(-30 -30) scale(0.05)" />
        </g>
      </g>
    </svg>
    <figcaption class="weg__zaehler">
      <span class="etikett">Heute</span>
      <span class="weg__zahl" data-zahl>0</span>
      <span class="etikett">/ 10.000 Schritte</span>
    </figcaption>
  </figure>

  <Fahrkarten />

  <section class="drei" aria-label="Was die App kann">
    <article class="drei__etappe reveal-scroll">
      <span class="drei__nr">I</span>
      <h2>Laufen</h2>
      <p>Deine Schritte aus Apple Health oder Health Connect – jeden Tag ein Stück weiter auf dem Weg.</p>
    </article>
    <article class="drei__etappe reveal-scroll">
      <span class="drei__nr">II</span>
      <h2>Messen</h2>
      <p>Tagesliga, Gruppen und Duelle gegen den Club. Wer abends noch läuft, holt auf.</p>
    </article>
    <article class="drei__etappe reveal-scroll">
      <span class="drei__nr">III</span>
      <h2>Dranbleiben</h2>
      <p>Deine Serie hält – mit Proviant für die Tage, an denen es mal nicht reicht.</p>
    </article>
  </section>
</MarschpassLayout>

<script>
  const weniger = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* Der Weg zeichnet sich, die Sonne läuft vorneweg, der Zähler läuft mit. */
  const linie = document.querySelector<SVGPathElement>('.weg__linie');
  const sonne = document.querySelector<SVGGElement>('.weg__sonne');
  const zahl = document.querySelector<HTMLElement>('[data-zahl]');
  const etappen = Array.from(document.querySelectorAll<SVGGElement>('.etappe'));
  const ZIEL = 10000;
  const fmt = new Intl.NumberFormat('de-DE');

  if (linie && sonne && zahl) {
    const laenge = linie.getTotalLength();
    // Wo auf dem Weg jede Etappe liegt (0..1), damit sie genau dann stempelt.
    const anteile = etappen.map((e) => {
      const m = e.transform.baseVal.consolidate()?.matrix;
      if (!m) return 1;
      let best = 0;
      let bestD = Infinity;
      for (let s = 0; s <= 200; s++) {
        const p = linie.getPointAtLength((s / 200) * laenge);
        const d = (p.x - m.e) ** 2 + (p.y - m.f) ** 2;
        if (d < bestD) {
          bestD = d;
          best = s / 200;
        }
      }
      return best;
    });

    const setze = (t: number) => {
      const p = linie.getPointAtLength(t * laenge);
      sonne.setAttribute('transform', `translate(${p.x} ${p.y})`);
      linie.style.strokeDashoffset = String(1000 * (1 - t));
      zahl.textContent = fmt.format(Math.round((t * ZIEL) / 10) * 10);
      etappen.forEach((e, i) => e.classList.toggle('gestempelt', t >= anteile[i] - 0.002));
      document.documentElement.classList.toggle('ziel', t >= 1);
    };

    if (weniger) {
      setze(1);
    } else {
      setze(0);
      const dauer = 3200;
      const start = performance.now() + 700;
      const ease = (x: number) => (x < 0.5 ? 4 * x * x * x : 1 - Math.pow(-2 * x + 2, 3) / 2);
      const schritt = (jetzt: number) => {
        const x = Math.min(1, Math.max(0, (jetzt - start) / dauer));
        setze(ease(x));
        if (x < 1) requestAnimationFrame(schritt);
      };
      requestAnimationFrame(schritt);
    }
  }

  /* Etappen unten kommen beim Scrollen. */
  const io = new IntersectionObserver(
    (eintraege) =>
      eintraege.forEach((e) => {
        if (e.isIntersecting) {
          e.target.classList.add('sichtbar');
          io.unobserve(e.target);
        }
      }),
    { threshold: 0.2 },
  );
  document.querySelectorAll('.reveal-scroll').forEach((el) => io.observe(el));
</script>

<style>
  /* ---------- Held ---------- */
  .held {
    position: relative;
    padding: clamp(40px, 8vw, 88px) 0 8px;
  }

  .held__etikett {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 22px;
    color: var(--glut);
  }

  .punkt {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--glut);
    animation: puls 2.4s ease-in-out infinite;
  }

  .held__titel {
    margin: 0;
    font-family: var(--f-titel);
    font-weight: 650;
    font-size: clamp(44px, 9.2vw, 108px);
    line-height: 0.98;
    letter-spacing: -0.035em;
    font-variation-settings: 'SOFT' 50, 'WONK' 0;
  }

  .held__titel em {
    font-style: italic;
    font-weight: 500;
    color: var(--glut);
  }

  .zeile {
    display: block;
  }

  .held__text {
    max-width: 540px;
    margin: 26px 0 0;
    font-size: clamp(17px, 2vw, 19px);
    color: var(--tinte-70);
  }

  /* Stempel „Neu Android“ – knallt nach dem Titel auf die Seite. */
  .stempel {
    position: absolute;
    right: clamp(0px, 3vw, 40px);
    top: clamp(28px, 7vw, 80px);
    width: clamp(112px, 16vw, 152px);
    aspect-ratio: 1;
    border: 2.5px solid var(--glut);
    border-radius: 50%;
    display: grid;
    place-content: center;
    gap: 2px;
    text-align: center;
    color: var(--glut);
    font-family: var(--f-mono);
    font-size: clamp(9px, 1.1vw, 11px);
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    transform: rotate(-12deg);
    opacity: 0;
    animation: stempeln 0.55s cubic-bezier(0.2, 1.6, 0.4, 1) 1.15s forwards;
    mix-blend-mode: multiply;
  }

  .stempel::before {
    content: '';
    position: absolute;
    inset: 6px;
    border: 1px dashed var(--glut);
    border-radius: 50%;
  }

  .stempel strong {
    font-family: var(--f-titel);
    font-size: clamp(20px, 2.8vw, 28px);
    letter-spacing: -0.01em;
    text-transform: none;
    font-weight: 700;
  }

  @media (prefers-color-scheme: dark) {
    .stempel {
      mix-blend-mode: normal;
    }
  }

  /* ---------- Der Weg ---------- */
  .weg {
    position: relative;
    margin: clamp(8px, 3vw, 24px) 0 0;
  }

  .weg__svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .weg__spur {
    fill: none;
    stroke: var(--tinte-45);
    stroke-width: 2;
    stroke-dasharray: 2 9;
    stroke-linecap: round;
  }

  .weg__linie {
    fill: none;
    stroke: var(--tinte);
    stroke-width: 4;
    stroke-linecap: round;
    stroke-dasharray: 1000;
    stroke-dashoffset: 1000;
  }

  .weg__start circle {
    fill: var(--tinte);
  }

  .weg text {
    font-family: var(--f-mono);
    font-weight: 600;
    font-size: 15px;
    letter-spacing: 0.12em;
    fill: var(--tinte-70);
    text-anchor: middle;
  }

  .etappe circle {
    fill: var(--grund);
    stroke: var(--tinte-45);
    stroke-width: 2;
    transition: fill 0.3s, stroke 0.3s;
  }

  .etappe text {
    opacity: 0.35;
    transition: opacity 0.3s;
  }

  .etappe.gestempelt circle {
    fill: var(--tinte);
    stroke: var(--tinte);
    animation: tupfen 0.4s cubic-bezier(0.2, 1.8, 0.4, 1);
    transform-box: fill-box;
    transform-origin: center;
  }

  .etappe.gestempelt text {
    opacity: 1;
  }

  .weg__sonne path {
    fill: var(--glut);
  }

  .weg__drehen {
    transform-box: fill-box;
    transform-origin: center;
    animation: drehen 14s linear infinite;
  }

  .weg__schein {
    fill: var(--glut);
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }

  :global(html.ziel) .weg__schein {
    animation: schein 2.8s ease-out infinite;
  }

  .weg__zaehler {
    position: absolute;
    left: 0;
    top: 0;
    display: flex;
    align-items: baseline;
    gap: 10px;
    flex-wrap: wrap;
    color: var(--tinte-70);
  }

  .weg__zahl {
    font-family: var(--f-titel);
    font-weight: 650;
    font-size: clamp(26px, 4vw, 40px);
    letter-spacing: -0.02em;
    color: var(--tinte);
    font-variant-numeric: tabular-nums;
    min-width: 5ch;
  }

  /* ---------- Drei Etappen ---------- */
  .drei {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-top: clamp(56px, 9vw, 96px);
    border-top: 1.5px solid var(--tinte);
  }

  .drei__etappe {
    padding: 24px 22px 8px 0;
    opacity: 0;
    translate: 0 18px;
    transition:
      opacity 0.7s ease-out,
      translate 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .drei__etappe + .drei__etappe {
    padding-left: 22px;
    border-left: 1px solid var(--tinte-14);
  }

  .drei__etappe:nth-child(2) {
    transition-delay: 0.1s;
  }

  .drei__etappe:nth-child(3) {
    transition-delay: 0.2s;
  }

  .drei__etappe:global(.sichtbar) {
    opacity: 1;
    translate: 0 0;
  }

  .drei__nr {
    font-family: var(--f-mono);
    font-weight: 600;
    font-size: 12px;
    letter-spacing: 0.16em;
    color: var(--glut);
  }

  .drei h2 {
    margin: 6px 0 8px;
    font-family: var(--f-titel);
    font-weight: 650;
    font-size: 30px;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .drei p {
    margin: 0;
    color: var(--tinte-70);
    font-size: 16px;
  }

  @media (max-width: 760px) {
    .drei {
      grid-template-columns: 1fr;
    }

    .drei__etappe,
    .drei__etappe + .drei__etappe {
      padding: 20px 0 16px;
      border-left: 0;
      border-bottom: 1px solid var(--tinte-14);
    }
  }

  /* ---------- Einblenden ---------- */
  .reveal {
    opacity: 0;
    translate: 0 0.4em;
    animation: auftauchen 0.9s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: calc(0.08s + var(--d) * 0.11s);
  }

  .held__titel .reveal {
    clip-path: inset(-0.2em -0.2em 0 -0.2em);
  }

  @keyframes auftauchen {
    to {
      opacity: 1;
      translate: 0 0;
    }
  }

  @keyframes stempeln {
    0% {
      opacity: 0;
      transform: rotate(-24deg) scale(2.2);
    }
    60% {
      opacity: 1;
    }
    100% {
      opacity: 0.92;
      transform: rotate(-12deg) scale(1);
    }
  }

  @keyframes tupfen {
    from {
      transform: scale(1.9);
    }
    to {
      transform: scale(1);
    }
  }

  @keyframes schein {
    0% {
      opacity: 0.35;
      transform: scale(0.4);
    }
    100% {
      opacity: 0;
      transform: scale(1.6);
    }
  }

  @keyframes drehen {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes puls {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.25;
    }
  }

  @media (max-width: 760px) {
    .weg__zaehler {
      position: static;
      margin-top: 8px;
    }

    .stempel {
      top: 14px;
      right: 0;
      width: 84px;
      font-size: 7.5px;
      gap: 0;
    }

    .stempel strong {
      font-size: 17px;
    }

    .stempel::before {
      inset: 4px;
    }

    /* Der Weg ist hier gut ein Drittel so breit – Striche und Schrift wachsen mit. */
    .weg text {
      font-size: 30px;
    }

    .weg__linie {
      stroke-width: 8;
    }

    .weg__spur {
      stroke-width: 4;
      stroke-dasharray: 3 14;
    }

    .etappe circle {
      r: 16px;
      stroke-width: 4;
    }

    .etappe text {
      transform: translateY(-14px);
    }

    .weg__start circle {
      r: 11px;
    }

    .weg__start text {
      transform: translateY(16px);
    }

    .weg__drehen {
      scale: 1.7;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .weg__drehen,
    .punkt,
    :global(html.ziel) .weg__schein {
      animation: none;
    }

    .reveal,
    .stempel {
      animation: none;
      opacity: 1;
      translate: 0 0;
    }

    .stempel {
      opacity: 0.92;
    }

    .drei__etappe {
      opacity: 1;
      translate: 0 0;
      transition: none;
    }
  }
</style>
