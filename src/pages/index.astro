---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import FeaturedEvent from '../components/FeaturedEvent.astro';
import Regions from '../components/Regions.astro';
import StampTeaser from '../components/StampTeaser.astro';
import CalendarTeaser from '../components/CalendarTeaser.astro';
import Manifest from '../components/Manifest.astro';
import StructuredData from '../components/StructuredData.astro';
import { buildEvents, nextFrom, toEventSchema } from '../lib/events';
import { loadEvents } from '../lib/events-source';
import { organizationSchema, venueListSchema } from '../lib/schema';

/** Zur Build-Zeit aus Supabase geladen (Fallback: src/data/events.json). */
const events = buildEvents(await loadEvents());
const nextEvent = nextFrom(events);
---

<BaseLayout
  title="Club Ludwig – Hiking Club Bonn"
  description="Der offene Hiking Club aus Bonn. Gemeinsam wandern, neue Leute kennenlernen und Wege rund um Rhein und Siebengebirge entdecken."
  transparentNav
>
  <StructuredData
    slot="head"
    schemas={[
      organizationSchema(),
      venueListSchema(),
      nextEvent ? toEventSchema(nextEvent) : null,
    ]}
  />

  <Hero />
  <FeaturedEvent event={nextEvent} />
  <CalendarTeaser />
  <Regions />
  <StampTeaser />
  <Manifest />
</BaseLayout>

<script>
  import { initHomeAnimations } from '../scripts/home-animations';

  initHomeAnimations();
</script>
