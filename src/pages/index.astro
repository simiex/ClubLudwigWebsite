---
/** Startseite: nur noch der Hinweis auf die Club Ludwig App. */
import QRCode from 'qrcode';
import AppLayout from '../layouts/AppLayout.astro';
import { app, site } from '../config/site';
import { shipped, upcoming } from '../lib/app-log';

const title = `${app.name} – ${site.name} Bonn`;
const description =
  'Club Ludwig gibt es jetzt als App. QR-Code scannen und die Beta über TestFlight auf dem iPhone installieren.';
const hasLog = shipped.length > 0 || upcoming.length > 0;

/* Zur Build-Zeit als SVG erzeugt – kein Script, keine externe Anfrage. */
const qrSvg = await QRCode.toString(app.testflight, {
  type: 'svg',
  errorCorrectionLevel: 'M',
  margin: 2,
  color: { dark: '#060d16', light: '#ffffff' },
});
---

<AppLayout title={title} description={description}>
  <main class="app">
    <img class="app__logo" src="/assets/logo-white.png" alt={site.name} width="660" height="136" />

    <h1 class="app__title">Club Ludwig gibt es jetzt als App.</h1>
    <p class="app__lead">
      Touren, Märsche, Stempelheft und dein Bereich – alles an einem Ort. Scann den Code mit der
      iPhone-Kamera und installier die Beta über TestFlight.
    </p>

    <a class="app__qr" href={app.testflight} aria-label="Club Ludwig App bei TestFlight öffnen">
      <Fragment set:html={qrSvg} />
    </a>

    <a class="app__cta" href={app.testflight}>Zur App bei TestFlight ↗</a>
    <p class="app__hint">Schon auf dem iPhone? Einfach auf den Button tippen.</p>

    {
      hasLog && (
        <a class="app__log" href="/neu/">
          {upcoming.length > 0 ? 'Was gerade neu ist und was bald kommt →' : 'Was gerade neu ist →'}
        </a>
      )
    }
  </main>
</AppLayout>

<style>
  .app {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 48px 16px 32px;
    max-width: 640px;
    margin: 0 auto;
  }

  .app__logo {
    width: min(240px, 60vw);
    height: auto;
    margin-bottom: 40px;
  }

  .app__title {
    margin: 0;
    font-size: clamp(30px, 5vw, 48px);
    line-height: 1.05;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .app__lead {
    margin: 18px 0 32px;
    color: var(--cream-72);
    font-size: 17px;
    line-height: 1.55;
  }

  .app__qr {
    display: block;
    width: min(260px, 70vw);
    padding: 10px;
    background: #fff;
    border-radius: var(--radius);
    box-shadow: var(--lime-glow);
  }

  .app__qr :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  .app__cta {
    margin-top: 32px;
    padding: 14px 24px;
    border-radius: var(--radius-sm);
    background: var(--color-lime);
    color: var(--color-night);
    font-weight: 700;
    text-decoration: none;
  }

  .app__cta:hover,
  .app__cta:focus-visible {
    box-shadow: var(--lime-glow);
  }

  .app__hint {
    margin: 14px 0 0;
    color: var(--cream-55);
    font-size: 14px;
  }

  .app__log {
    margin-top: 28px;
    color: var(--color-neon);
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
  }

  .app__log:hover,
  .app__log:focus-visible {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
