---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Principles from '../components/Principles.astro';
import FeaturedEvent from '../components/FeaturedEvent.astro';
import Regions from '../components/Regions.astro';
import Community from '../components/Community.astro';
import Manifest from '../components/Manifest.astro';
import FinalCta from '../components/FinalCta.astro';
import { getNextEvent } from '../lib/events';

const nextEvent = getNextEvent();
---

<BaseLayout
  title="Club Ludwig – Hiking Club Bonn"
  description="Der offene Hiking Club aus Bonn. Gemeinsam wandern, neue Leute kennenlernen und Wege rund um Rhein und Siebengebirge entdecken."
  transparentNav
>
  <Hero />
  <Principles event={nextEvent} />
  <FeaturedEvent event={nextEvent} />
  <Regions />
  <Community />
  <Manifest />
  <FinalCta />
</BaseLayout>

<script>
  import { initHomeAnimations } from '../scripts/home-animations';

  initHomeAnimations();
</script>
