---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Kicker from '../../components/Kicker.astro';
import SunMark from '../../components/SunMark.astro';
import { SUN_PATH } from '../../lib/sun';
---

<BaseLayout
  title="Monatsliga – Club Ludwig"
  description="Die Schritt-Rangliste des Club Ludwig. Jeden Monat neu, jeden Monat ein Sieger."
>
  <svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <symbol id="cl-sun" viewBox="0 0 1200 1200"><path d={SUN_PATH} /></symbol>
  </svg>

  <section class="lg" data-league>
    <div class="lg__inner">
      <header class="lg__head">
        <Kicker class="lg__kicker" animated>Monatsliga</Kicker>
        <h1>Wer geht<br /><span>am weitesten?</span></h1>
        <p class="lg__lead">
          Jeder Schritt zählt – zur Arbeit, mit dem Hund, auf Tour. Am Monatsende steht oben, wer
          am meisten unterwegs war. Wer den Monat gewinnt, bekommt ein Club-Ludwig-Paket.
        </p>
      </header>
      <!-- Monatswahl -->
      <nav class="months" aria-label="Monat wählen">
        <select class="months__select" data-month-select aria-label="Monat"></select>
        <p class="months__rest" data-rest></p>
      </nav>

      <div class="state" data-view="loading"><SunMark size={30} motion="spin" /></div>

      <div data-view="board" hidden>
        <!-- Treppchen -->
        <ol class="podium" data-podium aria-label="Die ersten drei"></ol>

        <!-- Der Rest -->
        <ol class="rest" data-rest-list></ol>

        <p class="lg__empty" data-empty hidden>
          In diesem Monat hat noch niemand Schritte eingetragen. Sei die erste Person.
        </p>

        <div class="lg__total">
          <p>
            <span data-total>0</span>
            <em data-total-label>Schritte gemeinsam in diesem Monat</em>
          </p>
        </div>
      </div>

      <div class="lg__cta">
        <p data-cta-text>Schritte eintragen kannst du in deinem Bereich.</p>
        <a class="btn btn--primary" href="/mein-club/#schritte" data-cta-link>Schritte eintragen</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { initLeague } from '../../scripts/league';

  initLeague();
</script>

<style>
  .lg {
    background:
      radial-gradient(70% 45% at 50% 0%, rgba(219, 255, 62, 0.09) 0%, transparent 62%),
      var(--color-night);
    color: var(--color-cream);
    padding: 200px var(--pad-x) 128px;
    min-height: 100vh;
  }

  .lg__inner {
    max-width: 860px;
    margin: 0 auto;
  }

  h1 {
    margin: 20px 0 0;
    font-size: clamp(40px, 5.6vw, 88px);
    font-weight: 800;
    line-height: 0.94;
    letter-spacing: -0.035em;
  }

  h1 span {
    color: var(--color-lime);
    text-shadow: 0 0 55px rgba(219, 255, 62, 0.35);
  }

  .lg__lead {
    margin: 26px 0 0;
    max-width: 52ch;
    font-size: 17px;
    line-height: 1.65;
    color: var(--cream-72);
  }

  .state {
    display: flex;
    justify-content: center;
    padding: 60px 0;
    color: var(--color-lime);
  }

  .lg :global([hidden]) {
    display: none !important;
  }

  /* ── Monatswahl ───────────────────────────────────────────────── */

  .months {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-top: 48px;
    flex-wrap: wrap;
  }

  .months__select {
    padding: 12px 18px;
    background: var(--color-surface-2);
    border: 1px solid var(--cream-line);
    border-radius: 999px;
    color: var(--color-cream);
    font-family: inherit;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .months__rest {
    margin: 0;
    font-size: 13px;
    color: var(--cream-55);
  }

  /* ── Treppchen ────────────────────────────────────────────────── */

  .podium {
    list-style: none;
    margin: 40px 0 0;
    padding: 0;
    display: grid;
    /* Passt sich der Zahl der Teilnehmenden an – bei einer Person keine
       zwei leeren Spalten daneben. */
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px;
    align-items: end;
  }

  /* Ohne Block-Darstellung fließen Name, Zahl und Zusatz ineinander. */
  .podium :global(.body) {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    width: 100%;
    min-width: 0;
  }

  .podium :global(li) {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 28px 16px 22px;
    background: var(--color-surface-2);
    border: 1px solid var(--cream-line);
    border-radius: var(--radius);
    text-align: center;
    overflow: hidden;
  }

  /* Erster Platz größer und mit Lichtschein */
  .podium :global(li.p1) {
    order: 2;
    padding-top: 40px;
    padding-bottom: 32px;
    border-color: rgba(219, 255, 62, 0.5);
    background:
      radial-gradient(80% 60% at 50% 0%, rgba(219, 255, 62, 0.16), transparent 70%),
      var(--color-surface-2);
    box-shadow: 0 0 60px rgba(219, 255, 62, 0.14);
  }

  .podium :global(li.p2) {
    order: 1;
  }

  .podium :global(li.p3) {
    order: 3;
  }

  /* Die Sonne als Siegerkranz hinter Platz eins */
  .podium :global(li.p1 .halo) {
    position: absolute;
    top: -46px;
    left: 50%;
    width: 150px;
    height: 150px;
    transform: translateX(-50%);
    fill: var(--color-lime);
    opacity: 0.07;
    animation: sun-spin 90s linear infinite;
  }

  .podium :global(.rank) {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--cream-45);
  }

  .podium :global(li.p1 .rank) {
    color: var(--color-lime);
  }

  .podium :global(.face) {
    position: relative;
    width: 62px;
    height: 62px;
    margin: 14px 0 12px;
    border-radius: 50%;
    overflow: hidden;
    background: var(--color-night);
    border: 1px solid var(--lime-line);
    display: grid;
    place-items: center;
    font-size: 20px;
    font-weight: 800;
    color: var(--color-lime);
  }

  .podium :global(li.p1 .face) {
    width: 82px;
    height: 82px;
    border-color: rgba(219, 255, 62, 0.55);
  }

  .podium :global(.face img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .podium :global(.name) {
    font-size: 15px;
    font-weight: 700;
    line-height: 1.25;
    overflow-wrap: anywhere;
  }

  .podium :global(.steps) {
    margin-top: 10px;
    font-size: 20px;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--color-lime);
    font-variant-numeric: tabular-nums;
  }

  .podium :global(li.p1 .steps) {
    font-size: 28px;
  }

  .podium :global(.sub) {
    margin-top: 4px;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--cream-45);
  }

  /* ── Plätze ab vier ───────────────────────────────────────────── */

  .rest {
    list-style: none;
    margin: 16px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .rest :global(li) {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 14px 22px;
    background: var(--color-surface-2);
    border: 1px solid var(--cream-line);
    border-radius: var(--radius-sm);
  }

  .rest :global(li.is-me) {
    border-color: rgba(219, 255, 62, 0.45);
  }

  .rest :global(.r) {
    width: 28px;
    font-size: 14px;
    font-weight: 800;
    color: var(--cream-45);
    font-variant-numeric: tabular-nums;
  }

  .rest :global(.face) {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    overflow: hidden;
    background: var(--color-night);
    display: grid;
    place-items: center;
    font-size: 12px;
    font-weight: 800;
    color: var(--color-lime);
    flex-shrink: 0;
  }

  .rest :global(.face img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .rest :global(.n) {
    flex: 1;
    min-width: 0;
    font-weight: 600;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .rest :global(.s) {
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .rest :global(.avg) {
    font-size: 12px;
    color: var(--cream-45);
    white-space: nowrap;
  }

  /* ── Fuß ──────────────────────────────────────────────────────── */

  .lg__total {
    margin-top: 40px;
    padding: 26px;
    text-align: center;
    border: 1px dashed var(--cream-line);
    border-radius: var(--radius);
  }

  .lg__total p {
    margin: 0;
  }

  .lg__total span {
    display: block;
    font-size: clamp(30px, 4vw, 46px);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--color-lime);
    font-variant-numeric: tabular-nums;
  }

  .lg__total em {
    display: block;
    margin-top: 6px;
    font-style: normal;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cream-45);
  }

  .lg__empty {
    margin: 32px 0 0;
    padding: 36px;
    border: 1px dashed var(--cream-line);
    border-radius: var(--radius);
    color: var(--cream-55);
  }

  .lg__cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-top: 48px;
    padding: 28px 32px;
    background: var(--color-surface-2);
    border: 1px solid var(--lime-line);
    border-radius: var(--radius);
    flex-wrap: wrap;
  }

  .lg__cta p {
    margin: 0;
    font-size: 15px;
    color: var(--cream-72);
  }

  @keyframes sun-spin {
    to {
      transform: translateX(-50%) rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .podium :global(li.p1 .halo) {
      animation: none;
    }
  }

  @media (max-width: 720px) {
    .lg {
      padding: 140px 20px 72px;
    }

    .podium {
      grid-template-columns: 1fr;
      gap: 10px;
    }

    .podium :global(li.p1),
    .podium :global(li.p2),
    .podium :global(li.p3) {
      order: 0;
      flex-direction: row;
      align-items: center;
      gap: 16px;
      text-align: left;
      padding: 18px 20px;
    }

    .podium :global(li .face) {
      width: 46px;
      height: 46px;
      margin: 0;
    }

    .podium :global(li.p1 .face) {
      width: 54px;
      height: 54px;
    }

    .podium :global(.body) {
      flex: 1;
      min-width: 0;
    }

    .podium :global(.steps),
    .podium :global(li.p1 .steps) {
      font-size: 20px;
      margin-top: 2px;
    }

    .podium :global(li.p1 .halo) {
      display: none;
    }

    .lg__cta .btn {
      width: 100%;
      text-align: center;
    }
  }
</style>
