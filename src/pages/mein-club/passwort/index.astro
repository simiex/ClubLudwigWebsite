---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Kicker from '../../../components/Kicker.astro';
---

<BaseLayout
  title="Neues Passwort – Club Ludwig"
  description="Setze ein neues Passwort für dein Club-Ludwig-Konto."
  noindex
>
  <section class="pw" data-password-reset>
    <div class="pw__inner">
      <Kicker class="pw__kicker">Mein Bereich</Kicker>
      <h1>Neues Passwort<br /><span>festlegen.</span></h1>

      <!-- Gültige Reset-Session vorhanden -->
      <form class="pw__form" data-pw-form hidden>
        <label class="field">
          <span class="field__label">Neues Passwort <span class="field__opt">(mind. 8 Zeichen)</span></span>
          <input class="field__input" type="password" autocomplete="new-password" required minlength="8" data-pw-input />
        </label>
        <label class="field">
          <span class="field__label">Passwort wiederholen</span>
          <input class="field__input" type="password" autocomplete="new-password" required minlength="8" data-pw-repeat />
        </label>
        <button class="btn btn--primary" type="submit">Passwort speichern</button>
      </form>

      <!-- Kein/abgelaufener Link -->
      <div class="pw__invalid" data-pw-invalid hidden>
        <p>
          Dieser Link ist abgelaufen oder wurde schon benutzt. Fordere auf der Anmeldeseite über
          „Passwort vergessen?“ einfach einen neuen an.
        </p>
        <a class="btn btn--ghost" href="/mein-club/">Zur Anmeldung</a>
      </div>

      <p class="msg" data-pw-msg data-tone="info" role="status" aria-live="polite"></p>
    </div>
  </section>
</BaseLayout>

<script>
  import { getSupabase } from '../../../lib/supabase';

  const root = document.querySelector<HTMLElement>('[data-password-reset]');
  if (root) {
    const supabase = getSupabase();
    const form = root.querySelector<HTMLFormElement>('[data-pw-form]');
    const invalid = root.querySelector<HTMLElement>('[data-pw-invalid]');
    const msg = root.querySelector<HTMLElement>('[data-pw-msg]');

    const setMsg = (text: string, tone: 'ok' | 'error' | 'info') => {
      if (!msg) return;
      msg.textContent = text;
      msg.dataset.tone = tone;
    };

    // Der Reset-Link erzeugt beim Öffnen eine Recovery-Session.
    // Erst nach der Session-Prüfung entscheiden, welche Ansicht gilt.
    void (async () => {
      // detectSessionInUrl braucht einen Tick, um den Hash auszuwerten
      await new Promise((r) => setTimeout(r, 400));
      const { data } = await supabase.auth.getSession();
      if (data.session) form?.removeAttribute('hidden');
      else invalid?.removeAttribute('hidden');
    })();

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const pw = root.querySelector<HTMLInputElement>('[data-pw-input]')?.value ?? '';
      const rp = root.querySelector<HTMLInputElement>('[data-pw-repeat]')?.value ?? '';
      if (pw.length < 8) {
        setMsg('Das Passwort muss mindestens 8 Zeichen haben.', 'error');
        return;
      }
      if (pw !== rp) {
        setMsg('Die Passwörter stimmen nicht überein.', 'error');
        return;
      }
      setMsg('Wird gespeichert …', 'info');
      const { error } = await supabase.auth.updateUser({ password: pw });
      if (error) {
        setMsg(`Das hat nicht geklappt: ${error.message}`, 'error');
        return;
      }
      setMsg('Passwort gespeichert – du wirst weitergeleitet …', 'ok');
      setTimeout(() => (window.location.href = '/mein-club/'), 1200);
    });
  }
</script>

<style>
  .pw {
    background:
      radial-gradient(70% 45% at 50% 0%, rgba(219, 255, 62, 0.1) 0%, transparent 62%),
      var(--color-night);
    color: var(--color-cream);
    padding: 200px var(--pad-x) 128px;
    min-height: 100vh;
  }

  .pw__inner {
    max-width: 460px;
    margin: 0 auto;
  }

  h1 {
    margin: 20px 0 0;
    font-size: clamp(36px, 4.6vw, 64px);
    font-weight: 800;
    line-height: 0.98;
    letter-spacing: -0.03em;
  }

  h1 span {
    color: var(--color-lime);
    text-shadow: 0 0 55px rgba(219, 255, 62, 0.38);
  }

  .pw__form {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-top: 40px;
  }

  .pw__form[hidden],
  .pw__invalid[hidden] {
    display: none;
  }

  .pw__invalid {
    margin-top: 40px;
  }

  .pw__invalid p {
    margin: 0 0 24px;
    font-size: 16px;
    line-height: 1.65;
    color: var(--cream-72);
  }

  .field__label {
    display: block;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--cream-55);
    margin-bottom: 10px;
  }

  .field__opt {
    text-transform: none;
    letter-spacing: 0.02em;
    font-weight: 500;
    color: var(--cream-45);
  }

  .field__input {
    width: 100%;
    padding: 16px 20px;
    background: var(--color-surface-2);
    border: 1px solid var(--cream-line);
    border-radius: var(--radius-sm);
    color: var(--color-cream);
    font-family: inherit;
    font-size: 16px;
  }

  .field__input:focus {
    outline: none;
    border-color: var(--color-lime);
    box-shadow: 0 0 0 3px rgba(219, 255, 62, 0.18);
  }

  .msg {
    margin: 18px 0 0;
    min-height: 22px;
    font-size: 15px;
    font-weight: 600;
  }

  .msg[data-tone='ok'] {
    color: var(--color-lime);
  }

  .msg[data-tone='error'] {
    color: #ff7b7b;
  }

  .msg[data-tone='info'] {
    color: var(--cream-55);
  }

  @media (max-width: 899px) {
    .pw {
      padding: 140px 24px 72px;
    }
  }
</style>
