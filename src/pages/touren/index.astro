---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StructuredData from '../../components/StructuredData.astro';
import Kicker from '../../components/Kicker.astro';
import {
  buildEvents,
  pastFrom,
  upcomingFrom,
  getEventMeta,
  getRegistrationTarget,
  isBookable,
  formatDay,
  formatFullDate,
  formatMonth,
  formatWeekday,
  STATUS_LABELS,
  STATUS_TONE,
  toEventSchema,
  type ClubEvent,
} from '../../lib/events';
import { loadEvents } from '../../lib/events-source';

/** Chronologisch: kommende aufsteigend, vergangene absteigend. */
const allEvents = buildEvents(await loadEvents());
const upcoming = upcomingFrom(allEvents);
const past = pastFrom(allEvents);

function cardData(event: ClubEvent) {
  return {
    event,
    meta: getEventMeta(event),
    registration: getRegistrationTarget(event),
    bookable: isBookable(event),
  };
}

const upcomingCards = upcoming.map(cardData);
const pastCards = past.map(cardData);
---

<BaseLayout
  title="Touren – Club Ludwig"
  description="Alle kommenden Wanderungen des Club Ludwig aus Bonn – mit Distanz, Höhenmetern, Schwierigkeitsgrad und Anmeldung."
>
  <StructuredData slot="head" schemas={upcoming.map(toEventSchema)} />

  <section class="tours-page">
    <div class="tours-page__inner">
      <Kicker class="tours-page__kicker">Tourenkalender</Kicker>
      <h1>Kommende Wanderungen</h1>
      <p class="tours-page__lead">
        Alle geplanten Touren auf einen Blick. Vor jeder Tour steht, wie lang und wie anspruchsvoll
        sie wird – such dir die aus, die zu dir passt.
      </p>

      {
        upcomingCards.length === 0 ? (
          <p class="tours-page__empty">
            Aktuell ist keine Tour ausgeschrieben. Neue Termine kündigen wir zuerst auf Instagram
            und bei Urban Sports Club an.
          </p>
        ) : (
          <ol class="tour-list">
            {upcomingCards.map(({ event, meta, registration, bookable }) => (
              <li class:list={['tour-card', { 'is-inactive': !bookable }]}>
                <div class="tour-card__date">
                  {event.hasDate ? (
                    <>
                      <span class="tour-card__day">{formatDay(event)}</span>
                      <span class="tour-card__month">{formatMonth(event)}</span>
                    </>
                  ) : (
                    <span class="tour-card__tbd">Termin folgt</span>
                  )}
                </div>
                <div class="tour-card__body">
                  <p class="tour-card__when">
                    {event.hasDate ? (
                      <>
                        {formatWeekday(event)}, {formatFullDate(event)}
                        {event.time && <> · {event.time} Uhr</>} ·{' '}
                      </>
                    ) : null}
                    {event.meetingPoint}
                  </p>
                  <h2>{event.title}</h2>
                  <p class="tour-card__desc">{event.description}</p>
                  {meta.length > 0 && (
                    <dl class="tour-card__meta">
                      {meta.map((m) => (
                        <div>
                          <dt>{m.label}</dt>
                          <dd>{m.value}</dd>
                        </div>
                      ))}
                    </dl>
                  )}
                  <div class="tour-card__foot">
                    <span class:list={['tour-card__status', `is-${STATUS_TONE[event.effectiveStatus]}`]}>
                      {STATUS_LABELS[event.effectiveStatus]}
                    </span>
                    {registration && bookable && (
                      <a
                        class="btn btn--primary tour-card__cta"
                        href={registration.href}
                        target={registration.external ? '_blank' : undefined}
                        rel={registration.external ? 'noopener' : undefined}
                      >
                        {registration.kind === 'usc' ? 'Bei Urban Sports Club buchen' : 'Anmelden'}
                        {registration.external && (
                          <span class="visually-hidden"> (öffnet in neuem Tab)</span>
                        )}
                      </a>
                    )}
                  </div>
                </div>
              </li>
            ))}
          </ol>
        )
      }

      {
        pastCards.length > 0 && (
          <section class="tours-past" aria-labelledby="past-heading">
            <h2 id="past-heading" class="tours-past__heading">
              Vergangene Touren
            </h2>
            <ol class="tour-list tour-list--past">
              {pastCards.map(({ event }) => (
                <li class="tour-card tour-card--past">
                  <div class="tour-card__date">
                    <span class="tour-card__day">{formatDay(event)}</span>
                    <span class="tour-card__month">{formatMonth(event)}</span>
                  </div>
                  <div class="tour-card__body">
                    <p class="tour-card__when">
                      {formatWeekday(event)}, {formatFullDate(event)} · {event.meetingPoint}
                    </p>
                    <h3>{event.title}</h3>
                    <span class:list={['tour-card__status', `is-${STATUS_TONE[event.effectiveStatus]}`]}>
                      {STATUS_LABELS[event.effectiveStatus]}
                    </span>
                  </div>
                </li>
              ))}
            </ol>
          </section>
        )
      }

      <a class="link-underline tours-page__back" href="/">Zurück zur Startseite</a>
    </div>
  </section>
</BaseLayout>

<style>
  .tours-page {
    background:
      radial-gradient(60% 40% at 15% 0%, rgba(219, 255, 62, 0.07) 0%, transparent 60%),
      var(--color-night);
    color: var(--color-cream);
    padding: 200px var(--pad-x) 128px;
    min-height: 100vh;
  }

  .tours-page__inner {
    max-width: 1080px;
    margin: 0 auto;
  }

  .tours-page__kicker {
    color: var(--color-lime);
  }

  h1 {
    margin: 20px 0 0;
    font-size: clamp(40px, 5vw, 84px);
    font-weight: 800;
    line-height: 0.98;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .tours-page__lead {
    margin: 24px 0 0;
    font-size: 17px;
    line-height: 1.65;
    color: var(--cream-72);
    max-width: 56ch;
  }

  .tours-page__empty {
    margin: 64px 0 0;
    padding: 40px;
    border: 1px dashed var(--cream-line);
    border-radius: var(--radius);
    font-size: 17px;
    line-height: 1.6;
    color: var(--cream-72);
  }

  .tour-list {
    list-style: none;
    margin: 72px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .tour-card {
    display: grid;
    grid-template-columns: 160px minmax(0, 1fr);
    gap: 40px;
    background: var(--color-surface-2);
    border: 1px solid var(--cream-line);
    border-radius: var(--radius);
    padding: 40px;
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .tour-card:hover,
  .tour-card:focus-within {
    border-color: rgba(219, 255, 62, 0.4);
    box-shadow: 0 0 46px rgba(219, 255, 62, 0.1);
  }

  .tour-card.is-inactive {
    opacity: 0.72;
  }

  .tour-card__date {
    display: flex;
    flex-direction: column;
  }

  .tour-card__day {
    color: var(--color-lime);
    font-size: 72px;
    font-weight: 800;
    line-height: 0.85;
    letter-spacing: -0.04em;
  }

  .tour-card__month {
    margin-top: 10px;
    font-size: 16px;
    font-weight: 700;
    color: var(--cream-55);
  }

  .tour-card__tbd {
    font-size: 20px;
    font-weight: 700;
    line-height: 1.2;
    color: var(--cream-45);
  }

  .tour-card__when {
    margin: 0;
    font-size: 13px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--cream-55);
  }

  .tour-card h2,
  .tour-card h3 {
    margin: 12px 0 0;
    font-size: clamp(28px, 3vw, 44px);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.02;
  }

  .tour-card__desc {
    margin: 16px 0 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--cream-72);
    max-width: 60ch;
  }

  .tour-card__meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 18px 24px;
    margin: 28px 0 0;
    padding-top: 24px;
    border-top: 1px solid var(--cream-line);
  }

  .tour-card__meta dt {
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(242, 238, 228, 0.5);
  }

  .tour-card__meta dd {
    margin: 5px 0 0;
    font-size: 15px;
    font-weight: 600;
  }

  .tour-card__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-top: 32px;
    flex-wrap: wrap;
  }

  .tour-card__status {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .tour-card__status.is-go {
    color: var(--color-lime);
  }

  .tour-card__status.is-warn {
    color: var(--color-ember);
  }

  .tour-card__status.is-stop {
    color: #ff6b6b;
  }

  .tour-card__status.is-muted {
    color: var(--cream-45);
  }

  .tour-card__cta {
    padding: 14px 28px;
    font-size: 14px;
  }

  /* Vergangene Touren: reduziert */
  .tours-past {
    margin-top: 112px;
    padding-top: 56px;
    border-top: 1px solid var(--cream-line);
  }

  .tours-past__heading {
    margin: 0;
    font-size: clamp(24px, 2.4vw, 34px);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--cream-72);
  }

  .tour-list--past {
    margin-top: 32px;
    gap: 20px;
  }

  .tour-card--past {
    padding: 24px 28px;
    opacity: 0.65;
  }

  .tour-card--past .tour-card__day {
    font-size: 40px;
    color: var(--cream-55);
  }

  .tour-card--past h3 {
    font-size: 22px;
    margin-bottom: 10px;
  }

  .tours-page__back {
    display: inline-block;
    margin-top: 64px;
    font-size: 15px;
    font-weight: 600;
    color: var(--cream-72);
  }

  @media (max-width: 899px) {
    .tours-page {
      padding: 140px 24px 72px;
    }

    .tour-card {
      grid-template-columns: 1fr;
      gap: 24px;
      padding: 28px 24px;
    }

    .tour-card__date {
      flex-direction: row;
      align-items: baseline;
      gap: 12px;
    }

    .tour-card__day {
      font-size: 48px;
    }

    .tour-card__foot {
      align-items: stretch;
      flex-direction: column;
    }

    .tour-card__cta {
      width: 100%;
    }
  }
</style>
