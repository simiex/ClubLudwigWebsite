---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Kicker from '../../components/Kicker.astro';
---

<BaseLayout
  title="Club Ludwig Shop – Merch für draußen und unterwegs"
  description="Entdecke Club-Ludwig-Merch für Wanderungen, Trails und gemeinsame Kilometer rund um Bonn."
>
  <main class="shop-page">
    <section class="shop-hero">
      <div class="shop-hero__glow" aria-hidden="true"></div>

      <div class="shop-hero__inner">
        <Kicker>Club Ludwig Shop</Kicker>

        <h1>
          Für draußen.<br />
          <span>Und alles danach.</span>
        </h1>

        <p>
          Club-Ludwig-Merch für Wanderungen, Trails und gemeinsame Kilometer.
          Direkt hier auswählen, in den Warenkorb legen und sicher über Shopify bezahlen.
        </p>

        <a class="shop-hero__link" href="#produkte">
          Produkte ansehen
          <span aria-hidden="true">↓</span>
        </a>
      </div>
    </section>

    <section id="produkte" class="shop-products">
      <div class="shop-products__inner">
        <div class="shop-products__header">
          <div>
            <Kicker>Kollektion</Kicker>
            <h2>Club Ludwig tragen.</h2>
          </div>

          <p>
            Produkte, Varianten und Verfügbarkeiten werden direkt aus unserem
            Shopify-Shop geladen.
          </p>
        </div>

        <div class="shop-products__embed">
          <div id="collection-component-1785939752730"></div>
        </div>
      </div>
    </section>
  </main>

  <script is:inline>
    (function () {
      var scriptURL =
        'https://sdks.shopifycdn.com/buy-button/latest/buy-button-storefront.min.js';

      if (window.ShopifyBuy) {
        if (window.ShopifyBuy.UI) {
          ShopifyBuyInit();
        } else {
          loadScript();
        }
      } else {
        loadScript();
      }

      function loadScript() {
        var script = document.createElement('script');
        script.async = true;
        script.src = scriptURL;

        (
          document.getElementsByTagName('head')[0] ||
          document.getElementsByTagName('body')[0]
        ).appendChild(script);

        script.onload = ShopifyBuyInit;
      }

      function ShopifyBuyInit() {
        var client = ShopifyBuy.buildClient({
          domain: '4fvn00-zm.myshopify.com',
          storefrontAccessToken: '88b1eae4e1856167991aba445a7d8643',
        });

        ShopifyBuy.UI.onReady(client).then(function (ui) {
          ui.createComponent('collection', {
            id: '674158412101',
            node: document.getElementById(
              'collection-component-1785939752730'
            ),
            moneyFormat: '%E2%82%AC%7B%7Bamount_with_comma_separator%7D%7D',

            options: {
              product: {
                styles: {
                  product: {
                    '@media (min-width: 601px)': {
                      'max-width': 'calc(25% - 20px)',
                      'margin-left': '20px',
                      'margin-bottom': '50px',
                      width: 'calc(25% - 20px)',
                    },

                    img: {
                      'border-radius': '18px',
                      'background-color': 'transparent',
                    },

                    imgWrapper: {
                      'border-radius': '18px',
                      overflow: 'hidden',
                      'background-color': '#060d16',
                    },

                    title: {
                      color: '#f2eee4',
                      'font-size': '18px',
                      'font-weight': '700',
                    },

                    price: {
                      color: 'rgba(242, 238, 228, 0.72)',
                      'font-size': '16px',
                      'margin-bottom': '20px',
                    },

                    variantTitle: {
                      color: 'rgba(242, 238, 228, 0.52)',
                      'font-size': '12px',
                      'font-weight': '700',
                      'letter-spacing': '0.08em',
                      'text-transform': 'uppercase',
                      'margin-bottom': '8px',
                    },

                    select: {
                      color: '#f2eee4',
                      'background-color': '#101a24',
                      border: '1px solid rgba(219, 255, 62, 0.22)',
                      'border-radius': '10px',
                      padding: '13px 42px 13px 14px',
                      'font-size': '14px',
                      'font-weight': '600',
                      'box-shadow': 'none',
                      outline: 'none',
                    },

                    selectIcon: {
                      fill: '#dbff3e',
                    },

                    options: {
                      'margin-bottom': '18px',
                    },
                  },

                  button: {
                    'background-color': '#dbff3e',
                    color: '#060d16',
                    'font-size': '13px',
                    'font-weight': '800',
                    'letter-spacing': '0.06em',
                    'text-transform': 'uppercase',
                    'border-radius': '8px',
                    padding: '15px 22px',

                    ':hover': {
                      'background-color': '#eaff7a',
                    },

                    ':focus': {
                      'background-color': '#eaff7a',
                    },
                  },
                },

                text: {
                  button: 'In den Warenkorb',
                },
              },

              productSet: {
                styles: {
                  products: {
                    '@media (min-width: 601px)': {
                      'margin-left': '-20px',
                    },
                  },
                },
              },

              modalProduct: {
                contents: {
                  img: false,
                  imgWithCarousel: true,
                  button: false,
                  buttonWithQuantity: true,
                },

                styles: {
                  product: {
                    '@media (min-width: 601px)': {
                      'max-width': '100%',
                      'margin-left': '0px',
                      'margin-bottom': '0px',
                    },
                  },

                  button: {
                    'background-color': '#dbff3e',
                    color: '#060d16',
                    'font-weight': '800',
                    'border-radius': '8px',

                    ':hover': {
                      'background-color': '#eaff7a',
                    },
                  },
                },

                text: {
                  button: 'In den Warenkorb',
                },
              },

              option: {},

              cart: {
                styles: {
                  button: {
                    'background-color': '#dbff3e',
                    color: '#060d16',
                    'font-weight': '800',
                    'border-radius': '8px',

                    ':hover': {
                      'background-color': '#eaff7a',
                    },
                  },
                },

                text: {
                  title: 'Warenkorb',
                  total: 'Zwischensumme',
                  empty: 'Dein Warenkorb ist noch leer.',
                  button: 'Zum Checkout',
                },
              },

              toggle: {
                styles: {
                  toggle: {
                    'background-color': '#dbff3e',

                    ':hover': {
                      'background-color': '#eaff7a',
                    },
                  },

                  count: {
                    color: '#060d16',
                  },

                  iconPath: {
                    fill: '#060d16',
                  },
                },
              },
            },
          });
        });
      }
    })();
  </script>
</BaseLayout>

<style>
  .shop-page {
    background: var(--color-night);
    color: var(--color-cream);
    min-height: 100vh;
  }

  .shop-hero {
    position: relative;
    overflow: hidden;
    min-height: 680px;
    display: flex;
    align-items: flex-end;
    padding: 180px var(--pad-x) 100px;
    background:
      radial-gradient(
        circle at 78% 30%,
        rgba(219, 255, 62, 0.13),
        transparent 34%
      ),
      linear-gradient(
        145deg,
        var(--color-night-deep) 0%,
        var(--color-night) 55%,
        var(--color-forest-mid) 100%
      );
  }

  .shop-hero__glow {
    position: absolute;
    top: 110px;
    right: -180px;
    width: 540px;
    height: 540px;
    border: 1px solid rgba(219, 255, 62, 0.2);
    border-radius: 50%;
    box-shadow:
      0 0 110px rgba(219, 255, 62, 0.1),
      inset 0 0 90px rgba(219, 255, 62, 0.04);
    pointer-events: none;
  }

  .shop-hero__inner {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: var(--max-width-content);
    margin: 0 auto;
  }

  .shop-hero h1 {
    margin: 24px 0 0;
    max-width: 900px;
    font-size: clamp(54px, 8vw, 118px);
    line-height: 0.88;
    letter-spacing: -0.055em;
    font-weight: 800;
  }

  .shop-hero h1 span {
    color: var(--color-lime);
  }

  .shop-hero p {
    max-width: 620px;
    margin: 34px 0 0;
    color: rgba(242, 238, 228, 0.7);
    font-size: 18px;
    line-height: 1.7;
  }

  .shop-hero__link {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-top: 42px;
    color: var(--color-cream);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .shop-hero__link span {
    color: var(--color-lime);
    font-size: 18px;
  }

  .shop-hero__link:hover {
    color: var(--color-lime);
  }

  .shop-products {
    padding: 110px var(--pad-x) 130px;
    background: var(--color-night-deep);
    border-top: 1px solid rgba(219, 255, 62, 0.16);
  }

  .shop-products__inner {
    max-width: var(--max-width-content);
    margin: 0 auto;
  }

  .shop-products__header {
    display: grid;
    grid-template-columns: minmax(0, 820px);
    gap: 24px;
    align-items: start;
    margin-bottom: 72px;
  }

  .shop-products__header h2 {
    margin: 18px 0 0;
    font-size: clamp(38px, 5vw, 74px);
    line-height: 0.98;
    letter-spacing: -0.04em;
  }

  .shop-products__header > p {
    margin: 0;
    max-width: 620px;
    color: rgba(242, 238, 228, 0.62);
    font-size: 16px;
    line-height: 1.7;
  }

  .shop-products__embed {
    min-height: 320px;
  }

  @media (max-width: 899px) {
    .shop-hero {
      min-height: 600px;
      padding: 150px 24px 72px;
    }

    .shop-hero__glow {
      top: 120px;
      right: -260px;
    }

    .shop-hero h1 {
      font-size: clamp(50px, 17vw, 82px);
    }

    .shop-hero p {
      font-size: 16px;
    }

    .shop-products {
      padding: 76px 24px 90px;
    }

    .shop-products__header {
      grid-template-columns: 1fr;
      gap: 26px;
      margin-bottom: 50px;
    }
  }
</style>
