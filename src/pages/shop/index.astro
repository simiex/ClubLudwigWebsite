---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Kicker from '../../components/Kicker.astro';
---

<BaseLayout
  title="Club Ludwig Shop – Merch für draußen und unterwegs"
  description="Entdecke Club-Ludwig-Merch für Wanderungen, Trails und gemeinsame Kilometer rund um Bonn."
>
  <main class="shop-page">
    <section class="shop-hero">
      <div class="shop-hero__glow" aria-hidden="true"></div>
      <div class="shop-hero__sun" aria-hidden="true">✦</div>

      <div class="shop-hero__inner">
        <Kicker>Club Ludwig Shop</Kicker>

        <h1>
          Für draußen.<br />
          <span>Und alles danach.</span>
        </h1>

        <p>
          Club-Ludwig-Merch für Wanderungen, Trails und gemeinsame Kilometer.
          Direkt hier auswählen, in den Warenkorb legen und sicher über Shopify bezahlen.
        </p>

        <div class="shop-hero__actions">
          <a class="shop-hero__link" href="#produkte">
            Produkte ansehen
            <span aria-hidden="true">↓</span>
          </a>

          <div class="shop-hero__meta" aria-label="Shop Vorteile">
            <span>Designed in Bonn</span>
            <span>Sicherer Checkout</span>
            <span>Club Merch</span>
          </div>
        </div>
      </div>
    </section>

    <section id="produkte" class="shop-products">
      <div class="shop-products__inner">
        <div class="shop-products__header">
          <div>
            <Kicker>Kollektion</Kicker>
            <h2>Club Ludwig tragen.</h2>
          </div>
        </div>

        <div class="shop-products__embed">
          <div id="collection-component-1785939752730"></div>
        </div>
      </div>
    </section>
  </main>

  <script is:inline>
    (function () {
      var scriptURL =
        'https://sdks.shopifycdn.com/buy-button/latest/buy-button-storefront.min.js';

      if (window.ShopifyBuy) {
        if (window.ShopifyBuy.UI) {
          ShopifyBuyInit();
        } else {
          loadScript();
        }
      } else {
        loadScript();
      }

      function loadScript() {
        var script = document.createElement('script');
        script.async = true;
        script.src = scriptURL;

        (
          document.getElementsByTagName('head')[0] ||
          document.getElementsByTagName('body')[0]
        ).appendChild(script);

        script.onload = ShopifyBuyInit;
      }

      function ShopifyBuyInit() {
        var client = ShopifyBuy.buildClient({
          domain: '4fvn00-zm.myshopify.com',
          storefrontAccessToken: '88b1eae4e1856167991aba445a7d8643',
        });

        ShopifyBuy.UI.onReady(client).then(function (ui) {
          ui.createComponent('collection', {
            id: '674158412101',
            node: document.getElementById(
              'collection-component-1785939752730'
            ),
            moneyFormat: '%E2%82%AC%7B%7Bamount_with_comma_separator%7D%7D',

            options: {
              product: {
                styles: {
                  product: {
                    '@media (min-width: 601px)': {
                      'max-width': 'calc(25% - 20px)',
                      'margin-left': '20px',
                      'margin-bottom': '50px',
                      width: 'calc(25% - 20px)',
                    },
                  },

                  img: {
                    'border-radius': '0px',
                    'background-color': 'transparent',
                  },

                  imgWrapper: {
                    'border-radius': '0px',
                    overflow: 'visible',
                    'background-color': 'transparent',
                  },

                  title: {
                    color: '#f2eee4',
                    'font-size': '18px',
                    'font-weight': '700',
                  },

                  price: {
                    color: 'rgba(242, 238, 228, 0.72)',
                    'font-size': '16px',
                    'margin-bottom': '22px',
                  },

                  button: {
                    'background-color': '#dbff3e',
                    color: '#060d16',
                    'font-size': '13px',
                    'font-weight': '800',
                    'letter-spacing': '0.06em',
                    'text-transform': 'uppercase',
                    'border-radius': '8px',
                    padding: '15px 22px',
                    'box-shadow': '0 0 0 1px rgba(219, 255, 62, 0.14), 0 10px 28px rgba(219, 255, 62, 0.08)',

                    ':hover': {
                      'background-color': '#eaff7a',
                    },

                    ':focus': {
                      'background-color': '#eaff7a',
                    },
                  },
                },

                text: {
                  button: 'In den Warenkorb',
                },
              },

              productSet: {
                styles: {
                  products: {
                    '@media (min-width: 601px)': {
                      'margin-left': '-20px',
                    },
                  },
                },
              },

              modalProduct: {
                contents: {
                  img: false,
                  imgWithCarousel: true,
                  button: false,
                  buttonWithQuantity: true,
                },

                styles: {
                  product: {
                    '@media (min-width: 601px)': {
                      'max-width': '100%',
                      'margin-left': '0px',
                      'margin-bottom': '0px',
                    },
                  },

                  button: {
                    'background-color': '#dbff3e',
                    color: '#060d16',
                    'font-weight': '800',
                    'border-radius': '8px',

                    ':hover': {
                      'background-color': '#eaff7a',
                    },
                  },
                },

                text: {
                  button: 'In den Warenkorb',
                },
              },

              option: {
                styles: {
                  label: {
                    color: 'rgba(242, 238, 228, 0.5)',
                    'font-size': '11px',
                    'font-weight': '800',
                    'letter-spacing': '0.12em',
                    'text-transform': 'uppercase',
                    'margin-bottom': '8px',
                  },

                  select: {
                    color: '#f2eee4',
                    'background-color': '#0b141e',
                    border: '1px solid rgba(219, 255, 62, 0.3)',
                    'border-radius': '9px',
                    height: '48px',
                    padding: '0 46px 0 15px',
                    'font-size': '14px',
                    'font-weight': '700',
                    'box-shadow': 'inset 0 0 0 1px rgba(255, 255, 255, 0.02)',
                    outline: 'none',
                  },

                  selectIcon: {
                    fill: '#dbff3e',
                    right: '15px',
                  },

                  option: {
                    color: '#060d16',
                  },
                },
              },

              cart: {
                styles: {
                  button: {
                    'background-color': '#dbff3e',
                    color: '#060d16',
                    'font-weight': '800',
                    'border-radius': '8px',

                    ':hover': {
                      'background-color': '#eaff7a',
                    },
                  },
                },

                text: {
                  title: 'Warenkorb',
                  total: 'Zwischensumme',
                  empty: 'Dein Warenkorb ist noch leer.',
                  button: 'Zum Checkout',
                },
              },

              toggle: {
                styles: {
                  toggle: {
                    'background-color': '#dbff3e',

                    ':hover': {
                      'background-color': '#eaff7a',
                    },
                  },

                  count: {
                    color: '#060d16',
                  },

                  iconPath: {
                    fill: '#060d16',
                  },
                },
              },
            },
          });
        });
      }
    })();
  </script>
</BaseLayout>

<style>
  .shop-page {
    background: var(--color-night);
    color: var(--color-cream);
    min-height: 100vh;
  }

  .shop-hero {
    position: relative;
    overflow: hidden;
    min-height: 720px;
    display: flex;
    align-items: flex-end;
    padding: 180px var(--pad-x) 100px;
    background:
      linear-gradient(rgba(219, 255, 62, 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(219, 255, 62, 0.045) 1px, transparent 1px),
      radial-gradient(circle at 78% 30%, rgba(219, 255, 62, 0.16), transparent 32%),
      linear-gradient(145deg, var(--color-night-deep) 0%, var(--color-night) 58%, var(--color-forest-mid) 100%);
    background-size: 64px 64px, 64px 64px, auto, auto;
  }

  .shop-hero::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 150px;
    background: linear-gradient(to bottom, transparent, var(--color-night-deep));
    pointer-events: none;
  }

  .shop-hero__glow {
    position: absolute;
    top: 80px;
    right: -130px;
    width: 620px;
    height: 620px;
    border: 1px solid rgba(219, 255, 62, 0.22);
    border-radius: 50%;
    box-shadow:
      0 0 140px rgba(219, 255, 62, 0.12),
      inset 0 0 110px rgba(219, 255, 62, 0.045);
    pointer-events: none;
  }

  .shop-hero__glow::before,
  .shop-hero__glow::after {
    content: '';
    position: absolute;
    border-radius: 50%;
    border: 1px solid rgba(219, 255, 62, 0.12);
  }

  .shop-hero__glow::before {
    inset: 78px;
  }

  .shop-hero__glow::after {
    inset: 158px;
  }

  .shop-hero__sun {
    position: absolute;
    top: 245px;
    right: 116px;
    color: var(--color-lime);
    font-size: 92px;
    line-height: 1;
    text-shadow: 0 0 42px rgba(219, 255, 62, 0.45);
    transform: rotate(16deg);
    pointer-events: none;
  }

  .shop-hero__inner {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: var(--max-width-content);
    margin: 0 auto;
  }

  .shop-hero h1 {
    margin: 24px 0 0;
    max-width: 920px;
    font-size: clamp(54px, 8vw, 118px);
    line-height: 0.88;
    letter-spacing: -0.055em;
    font-weight: 800;
  }

  .shop-hero h1 span {
    color: var(--color-lime);
  }

  .shop-hero p {
    max-width: 620px;
    margin: 34px 0 0;
    color: rgba(242, 238, 228, 0.7);
    font-size: 18px;
    line-height: 1.7;
  }

  .shop-hero__actions {
    display: flex;
    align-items: center;
    gap: 34px;
    flex-wrap: wrap;
    margin-top: 42px;
  }

  .shop-hero__link {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--color-cream);
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .shop-hero__link span {
    color: var(--color-lime);
    font-size: 18px;
  }

  .shop-hero__link:hover {
    color: var(--color-lime);
  }

  .shop-hero__meta {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .shop-hero__meta span {
    padding: 8px 12px;
    border: 1px solid rgba(242, 238, 228, 0.14);
    border-radius: 999px;
    background: rgba(6, 13, 22, 0.38);
    backdrop-filter: blur(8px);
    color: rgba(242, 238, 228, 0.6);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .shop-products {
    padding: 110px var(--pad-x) 130px;
    background: var(--color-night-deep);
    border-top: 1px solid rgba(219, 255, 62, 0.16);
  }

  .shop-products__inner {
    max-width: var(--max-width-content);
    margin: 0 auto;
  }

  .shop-products__header {
    display: grid;
    grid-template-columns: minmax(0, 820px);
    gap: 24px;
    align-items: start;
    margin-bottom: 72px;
  }

  .shop-products__header h2 {
    margin: 18px 0 0;
    font-size: clamp(38px, 5vw, 74px);
    line-height: 0.98;
    letter-spacing: -0.04em;
  }

  .shop-products__embed {
    min-height: 320px;
  }

  @media (max-width: 899px) {
    .shop-hero {
      min-height: 650px;
      padding: 150px 24px 72px;
      background-size: 42px 42px, 42px 42px, auto, auto;
    }

    .shop-hero__glow {
      top: 100px;
      right: -360px;
    }

    .shop-hero__sun {
      top: 205px;
      right: 24px;
      font-size: 56px;
      opacity: 0.75;
    }

    .shop-hero h1 {
      font-size: clamp(50px, 17vw, 82px);
    }

    .shop-hero p {
      font-size: 16px;
    }

    .shop-hero__actions {
      align-items: flex-start;
      flex-direction: column;
      gap: 24px;
    }

    .shop-products {
      padding: 76px 24px 90px;
    }

    .shop-products__header {
      grid-template-columns: 1fr;
      gap: 26px;
      margin-bottom: 50px;
    }
  }
</style>
