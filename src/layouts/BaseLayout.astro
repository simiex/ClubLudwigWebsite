---
import '@fontsource-variable/archivo';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  /** true auf der Startseite: transparente Navigation über dem Hero */
  transparentNav?: boolean;
  /** Persönliche Seiten gehören nicht in den Suchindex. */
  noindex?: boolean;
}

const { title, description, transparentNav = false, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/assets/og-image.png', Astro.site);
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#060D16" />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Club Ludwig" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="de_DE" />
    <meta name="twitter:card" content="summary_large_image" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Strukturierte Daten (schema.org) -->
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Zum Inhalt springen</a>
    <Header transparent={transparentNav} />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script is:inline>
      if (window.location.pathname === '/standorte/hofgarten/' || window.location.pathname === '/standorte/hofgarten') {
        const route = 'M330 88 C360 122 356 165 330 198 C298 238 270 260 250 300 C228 344 220 386 250 414 C282 444 332 438 382 410 C430 384 468 390 498 420 C524 446 546 468 575 458 C602 448 615 420 598 398 C580 375 548 366 526 344 C505 323 506 300 526 281 C550 258 586 251 608 228 C630 205 627 177 607 158 C586 138 558 128 535 112 C510 95 486 80 458 72 C420 62 374 67 330 88';
        document.querySelectorAll('.route-stage__route path').forEach((path) => path.setAttribute('d', route));
      }

      if (window.location.pathname === '/mein-club/' || window.location.pathname === '/mein-club') {
        const nativeConfirm = window.confirm.bind(window);
        window.confirm = (message) =>
          nativeConfirm(
            String(message)
              .replace(/ und Empfehlungscode/gi, '')
              .replace(/Empfehlungscode/gi, 'zugehörige Daten')
          );

        let attempts = 0;
        const cleanReferralUi = window.setInterval(() => {
          attempts += 1;

          document.querySelector('.promo')?.remove();

          const dangerText = document.querySelector('.danger__text');
          if (dangerText) {
            dangerText.textContent =
              'Du kannst dein Konto jederzeit löschen. Damit verschwinden dein Profil, deine Anmeldungen und deine Stempel unwiderruflich. Das lässt sich nicht rückgängig machen.';
          }

          document.querySelectorAll('.slot__label').forEach((label) => {
            if (label.textContent?.trim() === 'Empfehlung') label.textContent = 'Bonus';
          });

          document.querySelectorAll('.slot').forEach((slot) => {
            const title = slot.getAttribute('title');
            const aria = slot.getAttribute('aria-label');
            if (title?.match(/Empfehlung/i)) {
              slot.setAttribute('title', title.replace(/Empfehlung/gi, 'Bonus'));
            }
            if (aria?.match(/Empfehlung/i)) {
              slot.setAttribute('aria-label', aria.replace(/Empfehlung/gi, 'Bonus'));
            }
          });

          const slotsLoaded = document.querySelectorAll('.slot').length > 0;
          if (slotsLoaded || attempts >= 40) window.clearInterval(cleanReferralUi);
        }, 250);
      }
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: -100px;
    left: 16px;
    z-index: 100;
    background: var(--color-lime);
    color: var(--color-night);
    padding: 12px 20px;
    border-radius: var(--radius-sm);
    font-weight: 700;
  }

  .skip-link:focus-visible {
    top: 16px;
  }

  :global(.route-stage .kicker .kicker__sun) {
    color: var(--color-lime) !important;
  }
</style>
