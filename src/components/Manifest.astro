---
import Media from './Media.astro';
import { social, urbanSports } from '../config/site';
import { requireVenue } from '../data/venues';

const uscUrl = requireVenue(urbanSports.primaryVenueId).uscUrl;
---

<section class="manifest" aria-labelledby="manifest-heading">
  <div class="manifest__media" data-parallax>
    <Media name="manifest" alt="Wandergruppe auf einer Felskante über dem Rhein im Abendlicht" />
  </div>
  <div class="manifest__scrim"></div>
  <div class="manifest__head">
    <h2 id="manifest-heading" data-reveal>
      Bonn ist unser Startpunkt. <span>Nicht unser Limit.</span>
    </h2>

      <div class="manifest__btns" data-reveal>
        <a class="btn btn--primary" href={uscUrl} target="_blank" rel="noopener">
          Über Urban Sports Club anmelden<span class="visually-hidden"> (öffnet in neuem Tab)</span>
        </a>
        <a class="btn btn--ghost" href={social.strava} target="_blank" rel="noopener">
          Club Ludwig auf Strava<span class="visually-hidden"> (öffnet in neuem Tab)</span>
        </a>
      </div>
  </div>
</section>

<style>
  .manifest {
    position: relative;
    height: 100vh;
    min-height: 640px;
    overflow: hidden;
    background: var(--color-night-soft);
  }

  .manifest__media {
    position: absolute;
    inset: -8% 0;
  }

  .manifest__media-bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(120deg, var(--color-night-mid) 0%, var(--color-forest) 45%, var(--color-sand) 130%);
  }

  .manifest__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(3, 8, 14, 0.85) 0%,
      rgba(3, 8, 14, 0.25) 50%,
      rgba(3, 8, 14, 0.45) 100%
    );
    pointer-events: none;
  }

  .manifest__note {
    position: absolute;
    top: 40px;
    right: 48px;
    margin: 0;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cream-55);
    pointer-events: none;
    text-align: right;
  }

  .manifest__head {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 0 var(--pad-x);
    pointer-events: none;
  }

  h2 {
    margin: 0;
    font-size: clamp(44px, 6.5vw, 110px);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 0.98;
    color: var(--color-cream);
    max-width: 16ch;
    text-wrap: balance;
  }

  h2 span {
    color: var(--color-lime);
    text-shadow: 0 0 42px rgba(219, 255, 62, 0.45);
  }

  @media (max-width: 899px) {
    .manifest__head {
      padding: 0 24px;
    }
  }
  .manifest__btns {
    display: flex;
    justify-content: center;
    gap: 14px;
    margin-top: 40px;
    flex-wrap: wrap;
  }

  @media (max-width: 899px) {
    .manifest__btns {
      margin-top: 28px;
    }

    .manifest__btns .btn {
      width: 100%;
      text-align: center;
    }
  }
</style>
