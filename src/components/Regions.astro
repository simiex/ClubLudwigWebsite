---
import Media from './Media.astro';
import { venues } from '../data/venues';

/** Die Kacheln folgen einem 3er-Rhythmus (breit / schmal / mittig versetzt). */
const rhythm = ['a', 'b', 'c'] as const;
---

<section id="regionen" class="regions" aria-labelledby="regions-heading">
  <div class="regions__inner">
    <h2 id="regions-heading" data-reveal>Wo wir unterwegs sind</h2>
    <p class="regions__lead" data-reveal>
      Unser Clubgebiet zwischen Rhein, Wald und Siebengebirge. Jeder Standort ist über
      Urban Sports Club buchbar – im Kalender steht immer, was dich erwartet.
    </p>
    <div class="regions__grid">
      {
        venues.map((v, i) => {
          const isHofgarten = v.id === 'hofgarten';
          const detailUrl = isHofgarten ? '/standorte/hofgarten/' : v.uscUrl;

          return (
            <article class:list={['region', `region--${rhythm[i % 3]}`]} id={`standort-${v.id}`} data-reveal>
              <a
                class="region__media-link"
                href={detailUrl}
                aria-label={`${v.name} entdecken`}
                target={isHofgarten ? undefined : '_blank'}
                rel={isHofgarten ? undefined : 'noopener'}
              >
                <div class="region__media-wrap">
                  <div class="region__media" data-parallax>
                    <Media name={v.media} alt={v.alt} />
                  </div>
                  {isHofgarten && (
                    <span class="region__discover" aria-hidden="true">
                      Standort entdecken <b>→</b>
                    </span>
                  )}
                </div>
              </a>
              <div class="region__head">
                <h3>{v.name}</h3>
                <p class="region__area">{v.area}</p>
              </div>
              <p class="region__text">{v.text}</p>
              {
                isHofgarten ? (
                  <a class="region__link" href="/standorte/hofgarten/">
                    Standort entdecken
                    <span aria-hidden="true">→</span>
                  </a>
                ) : (
                  <a class="region__link" href={v.uscUrl} target="_blank" rel="noopener">
                    Standort bei Urban Sports Club
                    <span aria-hidden="true">↗</span>
                    <span class="visually-hidden">(öffnet in neuem Tab)</span>
                  </a>
                )
              }
            </article>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .regions {
    background: var(--color-surface);
    color: var(--color-cream);
    padding: 128px var(--pad-x) 96px;
  }

  .regions__inner {
    max-width: var(--max-width-content);
    margin: 0 auto;
  }

  h2 {
    margin: 0;
    font-size: clamp(32px, 3.6vw, 56px);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.05;
    max-width: 16ch;
    text-wrap: balance;
  }

  .regions__lead {
    margin: 24px 0 0;
    font-size: 17px;
    line-height: 1.6;
    color: var(--cream-65);
    max-width: 52ch;
  }

  .regions__grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 128px 32px;
    margin-top: 72px;
  }

  .region--a {
    grid-column: 1 / span 7;
  }

  .region--a .region__media-wrap {
    height: 560px;
  }

  .region--b {
    grid-column: 9 / span 4;
    margin-top: 160px;
  }

  .region--b .region__media-wrap {
    height: 420px;
  }

  .region--c {
    grid-column: 3 / span 8;
  }

  .region--c .region__media-wrap {
    height: 440px;
  }

  .region__media-link {
    display: block;
    color: inherit;
  }

  .region__media-wrap {
    position: relative;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--color-surface-2);
    border: 1px solid var(--lime-line);
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .region__media {
    position: relative;
    width: 100%;
    height: 110%;
    top: -5%;
    transition: transform 0.55s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .region:hover .region__media-wrap,
  .region:focus-within .region__media-wrap {
    border-color: rgba(219, 255, 62, 0.45);
    box-shadow: 0 0 40px rgba(219, 255, 62, 0.12);
  }

  .region:hover .region__media,
  .region:focus-within .region__media {
    transform: scale(1.025);
  }

  .region__discover {
    position: absolute;
    right: 22px;
    bottom: 22px;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    border: 1px solid rgba(219, 255, 62, 0.45);
    border-radius: 999px;
    background: rgba(3, 8, 14, 0.78);
    backdrop-filter: blur(12px);
    color: var(--color-lime);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transform: translateY(6px);
    opacity: 0;
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  .region:hover .region__discover,
  .region:focus-within .region__discover {
    opacity: 1;
    transform: translateY(0);
  }

  .region__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
    margin-top: 24px;
    flex-wrap: wrap;
  }

  h3 {
    margin: 0;
    font-size: clamp(26px, 2.4vw, 38px);
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .region__area {
    margin: 0;
    font-size: 13px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-lime);
    font-weight: 600;
  }

  .region__text {
    margin: 12px 0 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--cream-72);
    max-width: 52ch;
  }

  .region__link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 16px;
    font-size: 14px;
    font-weight: 600;
    color: var(--cream-72);
    border-bottom: 1px solid rgba(242, 238, 228, 0.25);
    padding-bottom: 3px;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .region__link:hover,
  .region__link:focus-visible {
    color: var(--color-lime);
    border-color: var(--color-lime);
  }

  @media (max-width: 899px) {
    .regions {
      padding: 72px 24px 56px;
    }

    .regions__grid {
      display: block;
    }

    .region--a,
    .region--b,
    .region--c {
      margin: 0 0 56px;
    }

    .region--a .region__media-wrap,
    .region--b .region__media-wrap,
    .region--c .region__media-wrap {
      height: 300px;
    }

    .region__discover {
      opacity: 1;
      transform: none;
      right: 14px;
      bottom: 14px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .region__media,
    .region__discover {
      transition: none;
    }
  }
</style>
