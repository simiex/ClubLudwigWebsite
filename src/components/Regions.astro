---
import Media from './Media.astro';
import { venues } from '../data/venues';

/** Die Kacheln folgen einem 3er-Rhythmus (breit / schmal / mittig versetzt). */
const rhythm = ['a', 'b', 'c'] as const;
---

<section id="regionen" class="regions" aria-labelledby="regions-heading">
  <div class="regions__inner">
    <h2 id="regions-heading" data-reveal>Wo wir unterwegs sind</h2>
    <p class="regions__lead" data-reveal>
      Unser Clubgebiet zwischen Rhein, Wald und Siebengebirge. Jeder Standort ist über
      Urban Sports Club buchbar – im Kalender steht immer, was dich erwartet.
    </p>
    <div class="regions__grid">
      {
        venues.map((v, i) => (
          <article class:list={['region', `region--${rhythm[i % 3]}`]} id={`standort-${v.id}`} data-reveal>
            <div class="region__media-wrap">
              <div class="region__media" data-parallax>
                <Media name={v.media} alt={v.alt} />
              </div>
            </div>
            <div class="region__head">
              <h3>{v.name}</h3>
              <p class="region__area">{v.area}</p>
            </div>
            <p class="region__text">{v.text}</p>
            <a class="region__link" href={v.uscUrl} target="_blank" rel="noopener">
              Standort bei Urban Sports Club
              <span aria-hidden="true">↗</span>
              <span class="visually-hidden">(öffnet in neuem Tab)</span>
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .regions {
    background: var(--color-surface);
    color: var(--color-cream);
    padding: 128px var(--pad-x) 96px;
  }

  .regions__inner {
    max-width: var(--max-width-content);
    margin: 0 auto;
  }

  h2 {
    margin: 0;
    font-size: clamp(32px, 3.6vw, 56px);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.05;
    max-width: 16ch;
    text-wrap: balance;
  }

  .regions__lead {
    margin: 24px 0 0;
    font-size: 17px;
    line-height: 1.6;
    color: var(--cream-65);
    max-width: 52ch;
  }

  .regions__grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    /*
     * Zeilenabstand gehört in den Grid-Gap, nicht in Einzel-Margins:
     * sonst fehlt er bei der jeweils ersten Kachel eines Dreier-Zyklus.
     */
    gap: 128px 32px;
    margin-top: 72px;
  }

  /* 3er-Rhythmus, wiederholt sich für weitere Standorte */
  .region--a {
    grid-column: 1 / span 7;
  }

  .region--a .region__media-wrap {
    height: 560px;
  }

  .region--b {
    grid-column: 9 / span 4;
    margin-top: 160px;
  }

  .region--b .region__media-wrap {
    height: 420px;
  }

  /* Versetzt nur innerhalb der eigenen Zeile – nicht als Zeilenabstand */
  .region--c {
    grid-column: 3 / span 8;
  }

  .region--c .region__media-wrap {
    height: 440px;
  }

  .region__media-wrap {
    position: relative;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--color-surface-2);
    border: 1px solid var(--lime-line);
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .region__media {
    position: relative;
    width: 100%;
    height: 110%;
    top: -5%;
  }

  .region:hover .region__media-wrap,
  .region:focus-within .region__media-wrap {
    border-color: rgba(219, 255, 62, 0.45);
    box-shadow: 0 0 40px rgba(219, 255, 62, 0.12);
  }

  .region__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
    margin-top: 24px;
    flex-wrap: wrap;
  }

  h3 {
    margin: 0;
    font-size: clamp(26px, 2.4vw, 38px);
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .region__area {
    margin: 0;
    font-size: 13px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-lime);
    font-weight: 600;
  }

  .region__text {
    margin: 12px 0 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--cream-72);
    max-width: 52ch;
  }

  .region__link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 16px;
    font-size: 14px;
    font-weight: 600;
    color: var(--cream-72);
    border-bottom: 1px solid rgba(242, 238, 228, 0.25);
    padding-bottom: 3px;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .region__link:hover,
  .region__link:focus-visible {
    color: var(--color-lime);
    border-color: var(--color-lime);
  }

  @media (max-width: 899px) {
    .regions {
      padding: 72px 24px 56px;
    }

    .regions__grid {
      display: block;
    }

    .region--a,
    .region--b,
    .region--c {
      margin: 0 0 56px;
    }

    .region--a .region__media-wrap,
    .region--b .region__media-wrap,
    .region--c .region__media-wrap {
      height: 300px;
    }
  }
</style>
