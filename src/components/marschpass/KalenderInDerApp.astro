---
/**
 * Werbung für den Marschkalender in der App – mit den Fahrkarten darunter.
 *
 * Die Punkte beschreiben, was die App wirklich kann (Stand Build 25+):
 * Merker „geplant“/„gebucht“ (MarschMerker), eigene Termine eintragen
 * (MarschEintragen.tsx – privat oder zur Prüfung), Region am Konto gemerkt,
 * Hinweis auf den nächsten Termin auf „Heute“. Ändert sich das in der App,
 * ändert sich dieser Text mit.
 */
import Fahrkarten from './Fahrkarten.astro';

interface Props {
  /** Überschrift anpassen, z. B. auf einer Regionsseite. */
  titel?: string;
  id?: string;
}

const { titel = 'Dein Marschkalender in der Tasche.', id = 'app' } = Astro.props;

const punkte = [
  {
    nr: 'I',
    titel: 'Vormerken',
    text: 'Ein Tipp, und der Marsch steht oben in deiner Liste – als „habe ich vor“ oder „Startplatz steht“.',
  },
  {
    nr: 'II',
    titel: 'Nicht verpassen',
    text: 'Der nächste Termin steht auf deinem Startbildschirm, mit den Tagen bis zum Start.',
  },
  {
    nr: 'III',
    titel: 'Eintragen',
    text: 'Dein Marsch fehlt? Trag ihn mit Name, Tag und Ort ein – nur für dich oder für alle im Club.',
  },
  {
    nr: 'IV',
    titel: 'Mitzählen',
    text: 'Am Marschtag laufen deine Schritte in die Tagesliga. 50 Kilometer tragen dich weit nach oben.',
  },
];
---

<section class="app" id={id} aria-labelledby={`${id}-titel`}>
  <p class="etikett app__etikett">
    <span class="punkt" aria-hidden="true"></span> Marschkalender · in der App
  </p>
  <h2 class="app__titel" id={`${id}-titel`}>{titel}</h2>
  <p class="app__text">
    Dieselben Termine wie hier, dazu deine eigenen – kostenlos für iPhone und Android.
  </p>

  <ol class="app__punkte">
    {
      punkte.map((p) => (
        <li class="app__punkt">
          <span class="app__nr">{p.nr}</span>
          <h3>{p.titel}</h3>
          <p>{p.text}</p>
        </li>
      ))
    }
  </ol>

  <Fahrkarten />
</section>

<style>
  .app {
    margin-top: clamp(56px, 9vw, 96px);
    padding-top: clamp(28px, 4vw, 40px);
    border-top: 1.5px solid var(--tinte);
  }

  .app__etikett {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 14px;
    color: var(--glut);
  }

  .punkt {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--glut);
  }

  .app__titel {
    margin: 0;
    max-width: 16ch;
    font-family: var(--f-titel);
    font-weight: 650;
    font-size: clamp(34px, 5.6vw, 64px);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .app__text {
    max-width: 520px;
    margin: 16px 0 0;
    color: var(--tinte-70);
    font-size: clamp(17px, 2vw, 19px);
  }

  .app__punkte {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin: clamp(28px, 4vw, 40px) 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--tinte-14);
  }

  .app__punkt {
    padding: 20px 18px 6px 0;
  }

  .app__punkt + .app__punkt {
    padding-left: 18px;
    border-left: 1px solid var(--tinte-14);
  }

  .app__nr {
    font-family: var(--f-mono);
    font-weight: 600;
    font-size: 12px;
    letter-spacing: 0.16em;
    color: var(--glut);
  }

  .app__punkt h3 {
    margin: 6px 0 6px;
    font-family: var(--f-titel);
    font-weight: 650;
    font-size: 24px;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .app__punkt p {
    margin: 0;
    color: var(--tinte-70);
    font-size: 15px;
  }

  @media (max-width: 900px) {
    .app__punkte {
      grid-template-columns: 1fr 1fr;
    }

    .app__punkt:nth-child(3) {
      padding-left: 0;
      border-left: 0;
    }
  }

  @media (max-width: 560px) {
    .app__punkte {
      grid-template-columns: 1fr;
    }

    .app__punkt,
    .app__punkt + .app__punkt {
      padding: 16px 0 14px;
      border-left: 0;
      border-bottom: 1px solid var(--tinte-14);
    }
  }
</style>
