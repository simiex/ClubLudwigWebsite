---
import SunMark from './SunMark.astro';
import Kicker from './Kicker.astro';
import { STAMP_GOAL, STAMP_GOAL_WORD, reward } from '../config/stempelheft';
import { social } from '../config/site';

/** Vorschau: alle Felder stempeln sich nacheinander voll und beginnen von vorn. */
const slots = Array.from({ length: STAMP_GOAL }, (_, i) => i);
---

<section class="teaser" aria-labelledby="teaser-heading">
  <div class="teaser__inner">
    <div class="teaser__text">
      <Kicker class="teaser__kicker">Stempelheft</Kicker>
      <h2 id="teaser-heading" data-reveal>
        {STAMP_GOAL_WORD} Stempel,<br /><span>ein Shirt.</span>
      </h2>
      <p class="teaser__lead" data-reveal>
        Einen Stempel gibt es fürs Mitwandern und für Bestellungen im Shop. Bei {STAMP_GOAL}
        Stempeln wartet das {reward.title}.
      </p>
      <div class="teaser__btns" data-reveal>
        <a class="btn btn--primary" href="/stempelheft/">Heft öffnen</a>
        <a class="btn btn--ghost" href={social.shop} target="_blank" rel="noopener">
          Zum Shop<span class="visually-hidden"> (öffnet in neuem Tab)</span>
        </a>
      </div>
    </div>

    <!-- Mini-Karte: stempelt sich beim Hereinscrollen selbst voll -->
    <ol class="mini" aria-hidden="true">
      {
        slots.map((i) => (
          <li class="mini__slot" style={`--i:${i}`}>
            <SunMark size={30} />
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .teaser {
    background:
      radial-gradient(60% 70% at 78% 50%, rgba(219, 255, 62, 0.09) 0%, transparent 62%),
      var(--color-night);
    color: var(--color-cream);
    padding: 128px var(--pad-x);
    border-top: 1px solid var(--lime-line);
  }

  .teaser__inner {
    max-width: var(--max-width-content);
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.85fr);
    gap: 80px;
    align-items: center;
  }

  h2 {
    margin: 20px 0 0;
    font-size: clamp(34px, 4.4vw, 68px);
    font-weight: 800;
    line-height: 0.98;
    letter-spacing: -0.03em;
  }

  h2 span {
    color: var(--color-lime);
    text-shadow: 0 0 50px rgba(219, 255, 62, 0.35);
  }

  .teaser__lead {
    margin: 24px 0 0;
    font-size: 17px;
    line-height: 1.65;
    color: var(--cream-72);
    max-width: 46ch;
  }

  .teaser__btns {
    display: flex;
    gap: 14px;
    margin-top: 36px;
    flex-wrap: wrap;
  }

  /* ── Mini-Karte ───────────────────────────────────────────────── */

  .mini {
    --cycle: 9s;
    --step: 1.1s;
    list-style: none;
    margin: 0;
    padding: 32px;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 16px;
    background: var(--color-surface-2);
    border: 1px solid var(--lime-line);
    border-radius: var(--radius);
    transform: rotate(-2.5deg);
    box-shadow: 0 30px 70px rgba(0, 0, 0, 0.45);
  }

  .mini__slot {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1;
    border: 1px dashed rgba(242, 238, 228, 0.2);
    border-radius: 50%;
    color: var(--color-lime);
    animation: slot-fill var(--cycle) linear infinite;
    animation-delay: calc(var(--i) * var(--step));
  }

  .mini__slot :global(svg) {
    animation: sun-stamp var(--cycle) linear infinite;
    animation-delay: calc(var(--i) * var(--step));
  }

  /* Ring, der beim Aufsetzen einmal nach außen läuft */
  .mini__slot::after {
    content: '';
    position: absolute;
    inset: -5px;
    border-radius: 50%;
    border: 2px solid var(--color-lime);
    opacity: 0;
    animation: ring-out var(--cycle) linear infinite;
    animation-delay: calc(var(--i) * var(--step));
  }

  /*
   * Ein Zyklus: aufstempeln, stehen bleiben, am Ende gemeinsam verblassen.
   * Die Prozentwerte sind auf --cycle bezogen; --step versetzt die Felder.
   */
  @keyframes sun-stamp {
    0%,
    1% {
      opacity: 0;
      transform: scale(2) rotate(-40deg);
    }
    4% {
      opacity: 1;
      transform: scale(0.86) rotate(-2deg);
    }
    7%,
    88% {
      opacity: 1;
      transform: scale(1) rotate(-8deg);
    }
    96%,
    100% {
      opacity: 0;
      transform: scale(1) rotate(-8deg);
    }
  }

  @keyframes slot-fill {
    0%,
    3% {
      border-style: dashed;
      border-color: rgba(242, 238, 228, 0.2);
      background: transparent;
      box-shadow: none;
    }
    5%,
    88% {
      border-style: solid;
      border-color: rgba(219, 255, 62, 0.45);
      background: radial-gradient(circle at 50% 45%, rgba(219, 255, 62, 0.1), transparent 70%);
      box-shadow: 0 0 22px rgba(219, 255, 62, 0.12);
    }
    96%,
    100% {
      border-style: dashed;
      border-color: rgba(242, 238, 228, 0.2);
      background: transparent;
      box-shadow: none;
    }
  }

  @keyframes ring-out {
    0%,
    2% {
      opacity: 0.85;
      transform: scale(0.75);
    }
    8%,
    100% {
      opacity: 0;
      transform: scale(1.5);
    }
  }

  @media (max-width: 1099px) {
    .teaser__inner {
      grid-template-columns: 1fr;
      gap: 56px;
    }

    .mini {
      max-width: 420px;
      transform: rotate(-1.5deg);
    }
  }

  @media (max-width: 899px) {
    .teaser {
      padding: 72px 24px;
    }

    .mini {
      padding: 20px;
      gap: 10px;
    }

    .teaser__btns .btn {
      flex: 1;
      min-width: 160px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mini__slot,
    .mini__slot :global(svg),
    .mini__slot::after {
      animation: none;
    }

    .mini__slot {
      border-style: solid;
      border-color: rgba(219, 255, 62, 0.45);
      background: radial-gradient(circle at 50% 45%, rgba(219, 255, 62, 0.1), transparent 70%);
    }

    .mini__slot::after {
      display: none;
    }
  }
</style>
