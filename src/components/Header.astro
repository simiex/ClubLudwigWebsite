---
interface Props {
  /** true: startet transparent über dem dunklen Hero (Startseite) */
  transparent?: boolean;
}

const { transparent = false } = Astro.props;

import SunMark from './SunMark.astro';
import { features, social, urbanSports } from '../config/site';
import { requireVenue } from '../data/venues';

/** "Mitwandern" führt zur Club-Ludwig-Seite bei Urban Sports Club (zentral konfiguriert). */
const USC_URL = requireVenue(urbanSports.primaryVenueId).uscUrl;

/**
 * EINE Quelle für Desktop- und Mobil-Navigation.
 * Vorher standen beide Listen getrennt im Markup und sind auseinandergelaufen:
 * mobil tauchten Challenges, Standorte und Stempelheft auf, die es auf dem
 * Desktop nie gab. Wer hier etwas ändert, ändert es an beiden Stellen.
 */
type NavItem = {
  label: string;
  href: string;
  /** externer Link -> target=_blank plus Hinweis für Screenreader */
  external?: boolean;
  hint?: string;
  /** auf dem Desktop rechts vom Logo statt links */
  side?: 'left' | 'right';
};

const navItems: NavItem[] = [
  { label: 'Shop', href: '/shop/', side: 'left' },
  { label: 'Marschkalender', href: '/maersche/', side: 'left' },
  // Ruht derzeit – siehe `features.monatsliga` in src/config/site.ts.
  ...(features.monatsliga
    ? [{ label: 'Monatsliga', href: '/liga/', side: 'left' } as NavItem]
    : []),
  { label: 'Mein Bereich', href: '/mein-club/', side: 'right' },
];

const navCta: NavItem = {
  label: 'Mitwandern',
  href: USC_URL,
  external: true,
  hint: ' bei Urban Sports Club (öffnet in neuem Tab)',
};

const navLeft = navItems.filter((item) => item.side !== 'right');
const navRight = navItems.filter((item) => item.side === 'right');
---

<header class:list={['site-header', { 'is-solid': !transparent }]} data-header data-transparent={transparent ? 'true' : null}>
  <div class="site-header__inner">
    <!-- Dreiteilig: die äußeren Spalten sind gleich breit, damit das Logo
         optisch mittig steht und nicht verrutscht, wenn die Links
         unterschiedlich lang sind. -->
    <nav class="site-header__nav site-header__nav--left" aria-label="Hauptnavigation">
      {navLeft.map((item) => (
        <a
          href={item.href}
          target={item.external ? '_blank' : undefined}
          rel={item.external ? 'noopener' : undefined}
        >
          {item.label}{item.hint && <span class="visually-hidden">{item.hint}</span>}
        </a>
      ))}
    </nav>

    <a class="site-header__logo" href={transparent ? '#top' : '/'} aria-label="Club Ludwig – Start">
      <img src="/assets/logo-white.png" alt="Club Ludwig" width="660" height="136" />
    </a>

    <nav class="site-header__nav site-header__nav--right" aria-label="Mein Bereich und Anmeldung">
      {navRight.map((item) => (
        <a
          href={item.href}
          target={item.external ? '_blank' : undefined}
          rel={item.external ? 'noopener' : undefined}
        >
          {item.label}{item.hint && <span class="visually-hidden">{item.hint}</span>}
        </a>
      ))}
      <a class="site-header__cta" href={navCta.href} target="_blank" rel="noopener">
        {navCta.label}<span class="visually-hidden">{navCta.hint}</span>
      </a>
    </nav>
    <button class="site-header__burger" data-menu-toggle aria-label="Menü öffnen" aria-expanded="false" aria-controls="mobile-menu">
      <span></span>
      <span></span>
    </button>
  </div>
</header>

<div class="mobile-menu" id="mobile-menu" data-menu hidden>
  <nav aria-label="Mobile Navigation">
    {navItems.map((item) => (
      <a
        href={item.href}
        target={item.external ? '_blank' : undefined}
        rel={item.external ? 'noopener' : undefined}
        data-menu-link
      >
        {item.label}{item.hint && <span class="visually-hidden">{item.hint}</span>}
      </a>
    ))}
  </nav>
  <a class="btn btn--primary mobile-menu__cta" href={navCta.href} target="_blank" rel="noopener" data-menu-link>
    {navCta.label}<span class="visually-hidden">{navCta.hint}</span>
  </a>
  <p class="mobile-menu__tag">
    <SunMark size={14} motion="spin" />
    <span>Hiking Club · Bonn</span>
  </p>
</div>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 60;
    background: transparent;
    border-bottom: 1px solid transparent;
    transition: background 0.35s ease, border-color 0.35s ease, backdrop-filter 0.35s ease;
  }

  .site-header__inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 26px var(--pad-x);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
    transition: padding 0.35s ease;
  }

  .site-header__logo {
    display: block;
    position: relative;
    justify-self: center;
  }

  .site-header__logo img {
    height: 34px;
    width: auto;
    display: block;
  }

  .site-header__nav {
    display: flex;
    align-items: center;
    gap: 26px;
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0.01em;
  }

  .site-header__nav--left {
    justify-content: flex-start;
  }

  .site-header__nav--right {
    justify-content: flex-end;
  }

  .site-header__nav a {
    color: var(--color-cream);
    transition: color 0.2s ease;
  }

  .site-header__nav a:not(.site-header__cta):hover {
    color: var(--color-lime);
  }

  .site-header__cta {
    background: var(--color-lime);
    color: var(--color-night) !important;
    padding: 12px 24px;
    border-radius: var(--radius-sm);
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    box-shadow: var(--lime-glow);
    transition: background 0.2s ease, box-shadow 0.2s ease;
  }

  .site-header__cta:hover {
    background: #eaff7a;
    box-shadow: 0 0 32px rgba(219, 255, 62, 0.55);
  }

  .site-header__burger {
    display: none;
    flex-direction: column;
    gap: 6px;
    background: none;
    border: none;
    padding: 10px;
    cursor: pointer;
  }

  .site-header__burger span {
    display: block;
    width: 26px;
    height: 2px;
    background: var(--color-cream);
  }

  /* Eingescrollt: dunkle Glasleiste mit Neon-Kante – kein Farbwechsel nach Weiß */
  .site-header.is-solid {
    background: rgba(6, 13, 22, 0.82);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    border-bottom-color: var(--lime-line);
  }

  .site-header.is-scrolled .site-header__inner {
    padding-top: 14px;
    padding-bottom: 14px;
  }

  /* Offenes Menü: volle dunkle Fläche */
  .site-header.is-menu-open {
    background: var(--color-night);
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    border-bottom-color: transparent;
  }

  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 55;
    background: var(--color-night);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 32px 28px;
  }

  .mobile-menu[hidden] {
    display: none;
  }

  .mobile-menu nav {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .mobile-menu nav a {
    font-size: 40px;
    font-weight: 700;
    letter-spacing: -0.02em;
    padding: 10px 0;
    color: var(--color-cream);
  }

  .mobile-menu nav a:hover {
    color: var(--color-lime);
  }

  .mobile-menu__cta {
    margin-top: 40px;
    padding: 20px;
    font-size: 16px;
  }

  .mobile-menu__tag {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 48px;
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(242, 238, 228, 0.5);
  }

  @media (max-width: 899px) {
    .site-header__nav {
      display: none;
    }

    /* Ohne die beiden Navi-Spalten säße das Logo sonst in der Mitte,
       während links eine leere Spalte klafft. */
    .site-header__inner {
      grid-template-columns: auto auto;
      justify-content: space-between;
      gap: 12px;
      padding-left: 20px;
      padding-right: 20px;
    }

    .site-header__logo {
      justify-self: start;
    }

    .site-header__logo img {
      height: 28px;
    }

    /* 44x44 Trefferfläche und ein sichtbarer Auf/Zu-Zustand – vorher blieben
       es in jedem Zustand dieselben zwei Striche. */
    .site-header__burger {
      display: flex;
      position: relative;
      width: 44px;
      height: 44px;
      padding: 0;
      gap: 0;
      flex: 0 0 auto;
      align-items: center;
      justify-content: center;
      z-index: 2;
    }

    .site-header__burger span {
      position: absolute;
      left: 10px;
      width: 24px;
      transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .site-header__burger span:first-child {
      transform: translateY(-4px);
    }

    .site-header__burger span:last-child {
      transform: translateY(4px);
    }

    .site-header.is-menu-open .site-header__burger span:first-child {
      transform: translateY(0) rotate(45deg);
    }

    .site-header.is-menu-open .site-header__burger span:last-child {
      transform: translateY(0) rotate(-45deg);
    }

    /* Zentriert und ohne Scroll lief das Menü auf kurzen Geräten unten raus;
       CTA und Fußzeile waren dort nicht erreichbar. */
    .mobile-menu {
      justify-content: flex-start;
      overflow-y: auto;
      overscroll-behavior: contain;
      -webkit-overflow-scrolling: touch;
      padding:
        calc(96px + env(safe-area-inset-top)) 24px
        calc(28px + env(safe-area-inset-bottom));
    }

    .mobile-menu nav {
      gap: 0;
    }

    .mobile-menu nav a {
      font-size: clamp(28px, 7.4vw, 40px);
      line-height: 1.14;
      padding: 10px 0;
    }

    .mobile-menu__cta {
      margin-top: auto;
      padding: 18px;
      flex: 0 0 auto;
    }

    .mobile-menu__tag {
      margin-top: 22px;
      flex: 0 0 auto;
    }
  }

  /* iPhone SE, Landscape & Co. */
  @media (max-width: 899px) and (max-height: 640px) {
    .mobile-menu {
      padding-top: calc(84px + env(safe-area-inset-top));
    }

    .mobile-menu nav a {
      font-size: 26px;
      padding: 7px 0;
    }

    .mobile-menu__cta {
      margin-top: 24px;
      padding: 15px;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const transparent = header?.dataset.transparent === 'true';

  let menuOpen = false;

  function syncHeader() {
    if (!header) return;
    const scrolled = window.scrollY > 40;
    header.classList.toggle('is-scrolled', scrolled);
    if (transparent) header.classList.toggle('is-solid', scrolled && !menuOpen);
  }

  function setMenu(open: boolean) {
    if (!header || !toggle || !menu) return;
    menuOpen = open;
    menu.hidden = !open;
    if (open) menu.scrollTop = 0;
    header.classList.toggle('is-menu-open', open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Menü schließen' : 'Menü öffnen');
    document.body.style.overflow = open ? 'hidden' : '';
    syncHeader();
  }

  toggle?.addEventListener('click', () => setMenu(!menuOpen));
  menu?.querySelectorAll('[data-menu-link]').forEach((link) => {
    link.addEventListener('click', () => setMenu(false));
  });
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menuOpen) setMenu(false);
  });
  window.addEventListener('scroll', syncHeader, { passive: true });
  syncHeader();
</script>
