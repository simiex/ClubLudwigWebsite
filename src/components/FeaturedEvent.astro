---
import Kicker from './Kicker.astro';
import type { ClubEvent } from '../lib/events';
import {
  formatDay,
  formatMonth,
  formatWeekday,
  formatYear,
  getEventMeta,
  getRegistrationTarget,
  isBookable,
  STATUS_LABELS,
  STATUS_TONE,
} from '../lib/events';

interface Props {
  /** null, wenn noch keine Tour hinterlegt ist. */
  event: ClubEvent | null;
}

const { event } = Astro.props;

const meta = event ? getEventMeta(event) : [];
const registration = event ? getRegistrationTarget(event) : null;
const bookable = event ? isBookable(event) : false;
---

<section id="touren" class="featured" aria-labelledby="featured-heading">
  <div class="featured__inner">
    {
      !event ? (
        <div class="featured__empty">
          <Kicker class="featured__kicker">Nächste Wanderung</Kicker>
          <h2 id="featured-heading">Der nächste Termin steht noch nicht fest.</h2>
          <p class="featured__desc">
            Sobald die nächste Tour geplant ist, findest du sie hier und im Tourenkalender.
          </p>
          <div class="featured__ctas">
            <a class="link-underline featured__all" href="/touren/">Alle Touren ansehen</a>
          </div>
        </div>
      ) : (
        <>
          <div class="featured__head" data-reveal>
            <Kicker class="featured__kicker">Nächste Wanderung</Kicker>
            <p class:list={['featured__status', `is-${STATUS_TONE[event.effectiveStatus]}`]}>
              {STATUS_LABELS[event.effectiveStatus]}
            </p>
          </div>
          <div class="featured__grid">
            <div class="featured__date" data-reveal>
              {event.hasDate ? (
                <>
                  <p class="featured__day">{formatDay(event)}</p>
                  <p class="featured__month">
                    {formatMonth(event)} <span>{formatYear(event)}</span>
                  </p>
                  <p class="featured__weekday">
                    {formatWeekday(event)}
                    {event.time && <> · {event.time} Uhr</>}
                  </p>
                </>
              ) : (
                <>
                  <p class="featured__tbd">Termin<br />folgt</p>
                  <p class="featured__weekday">Aktuelle Termine über Urban Sports Club</p>
                </>
              )}
            </div>
            <div>
              <h2 id="featured-heading" data-reveal>{event.title}</h2>
              <p class="featured__desc" data-reveal>{event.description}</p>
              {meta.length > 0 && (
                <dl class="featured__meta">
                  {meta.map((m) => (
                    <div class:list={[{ 'is-wide': m.wide }]}>
                      <dt>{m.label}</dt>
                      <dd>{m.value}</dd>
                    </div>
                  ))}
                </dl>
              )}
              <div class="featured__ctas">
                {registration && bookable ? (
                  <a
                    class="btn btn--primary"
                    href={registration.href}
                    target={registration.external ? '_blank' : undefined}
                    rel={registration.external ? 'noopener' : undefined}
                  >
                    {registration.kind === 'usc' ? 'Über Urban Sports Club anmelden' : 'Jetzt anmelden'}
                    {registration.external && (
                      <span class="visually-hidden"> (öffnet in neuem Tab)</span>
                    )}
                  </a>
                ) : (
                  <p class="featured__closed">
                    {event.effectiveStatus === 'abgesagt'
                      ? 'Diese Tour wurde abgesagt.'
                      : event.effectiveStatus === 'ausgebucht'
                        ? 'Diese Tour ist ausgebucht.'
                        : 'Für diese Tour ist keine Anmeldung mehr möglich.'}
                  </p>
                )}
                <a class="link-underline featured__all" href="/touren/">Alle Touren ansehen</a>
              </div>
            </div>
          </div>
        </>
      )
    }
  </div>
</section>

<style>
  .featured {
    position: relative;
    background:
      radial-gradient(60% 50% at 12% 0%, rgba(219, 255, 62, 0.07) 0%, transparent 60%),
      var(--color-night);
    color: var(--color-cream);
    padding: 128px var(--pad-x);
  }

  .featured__inner {
    max-width: var(--max-width-content);
    margin: 0 auto;
  }

  .featured__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }

  .featured__kicker {
    color: var(--color-lime);
  }

  .featured__status {
    margin: 0;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .featured__status.is-go {
    color: var(--color-lime);
  }

  .featured__status.is-warn {
    color: var(--color-ember);
  }

  .featured__status.is-stop {
    color: #ff6b6b;
  }

  .featured__status.is-muted {
    color: var(--cream-45);
  }

  .featured__tbd {
    margin: 0;
    font-size: clamp(44px, 5vw, 76px);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.03em;
    color: var(--cream-45);
  }

  .featured__closed {
    margin: 0;
    font-size: 15px;
    font-weight: 600;
    color: var(--cream-65);
  }

  .featured__empty h2 {
    margin-top: 20px;
  }

  .featured__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: 80px;
    margin-top: 48px;
    align-items: end;
  }

  .featured__day {
    margin: 0;
    color: var(--color-cream);
    text-shadow: 0 0 60px rgba(219, 255, 62, 0.22);
    font-size: clamp(120px, 16vw, 240px);
    font-weight: 800;
    line-height: 0.82;
    letter-spacing: -0.04em;
  }

  .featured__month {
    margin: 12px 0 0;
    font-size: clamp(28px, 3vw, 44px);
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .featured__month span {
    color: var(--cream-45);
  }

  .featured__weekday {
    margin: 10px 0 0;
    font-size: 14px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--cream-55);
  }

  h2 {
    margin: 0;
    font-size: clamp(40px, 4.6vw, 76px);
    font-weight: 800;
    line-height: 0.98;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .featured__desc {
    margin: 24px 0 0;
    font-size: 17px;
    line-height: 1.65;
    color: var(--cream-72);
    max-width: 56ch;
  }

  .featured__meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, auto));
    gap: 0 8px;
    margin: 40px 0 0;
    border-top: 1px solid var(--lime-line);
  }

  .featured__meta > div {
    padding: 18px 32px 0 0;
  }

  .featured__meta > div.is-wide {
    padding-bottom: 14px;
  }

  .featured__meta dt {
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(242, 238, 228, 0.5);
  }

  .featured__meta dd {
    margin: 6px 0 0;
    font-size: 17px;
    font-weight: 700;
    white-space: nowrap;
  }

  .featured__meta > div.is-wide dd {
    font-size: 15px;
    font-weight: 600;
    white-space: normal;
  }


  .featured__ctas {
    display: flex;
    align-items: center;
    gap: 28px;
    margin-top: 44px;
    flex-wrap: wrap;
  }

  .featured__all {
    font-size: 15px;
    font-weight: 600;
    color: rgba(242, 238, 228, 0.75);
  }



  @media (max-width: 899px) {
    .featured {
      padding: 72px 24px;
    }

    /* 1fr entspricht minmax(auto, 1fr): die beiden CTA-Buttons nebeneinander
       erzwangen so eine Mindestbreite von 354px und sprengten schmale Displays. */
    .featured__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 36px;
    }

    .featured__ctas {
      gap: 18px;
    }

    .featured__day {
      font-size: 96px;
    }

    .featured__meta {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 0 24px;
    }
  }

  @media (max-width: 420px) {
    .featured__ctas {
      align-items: stretch;
    }

    .featured__ctas :global(.btn) {
      width: 100%;
    }
  }
</style>
