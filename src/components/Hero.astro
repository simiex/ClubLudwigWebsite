---
interface Props {
  memberCount?: number;
  showStats?: boolean;
}

const { memberCount = 240, showStats = true } = Astro.props;
---

<section id="hero" class="hero" aria-label="Intro">
  <span id="top" class="hero__anchor" aria-hidden="true"></span>
  <div class="hero__sticky">
    <div class="hero__media" data-hero-media>
      <div class="hero__media-bg"></div>
      <!-- TODO: Platzhalter durch echtes Hero-Video/-Foto ersetzen (assets/hero.*) -->
      <p class="hero__media-note" aria-hidden="true">
        Video-Platzhalter · Kamerafahrt<br />Bonn/Hofgarten → Rhein → Wald
      </p>
      <div class="hero__scrim" data-hero-scrim></div>
    </div>
    <div class="hero__content" data-hero-content>
      <p class="kicker hero__kicker">Hiking Club · Bonn</p>
      <h1>From Beethoven&rsquo;s City to the&nbsp;Trails</h1>
      <p class="hero__lead">
        Der offene Hiking Club aus Bonn. Gemeinsam wandern, neue Leute kennenlernen und Wege rund
        um Rhein und Siebengebirge entdecken.
      </p>
      <div class="hero__ctas">
        <a class="btn btn--primary" href="#touren">Tour ansehen</a>
        <a class="btn btn--ghost" href="#club">Club entdecken</a>
      </div>
      {
        showStats && (
          <dl class="hero__stats">
            <div>
              <dd>{memberCount}+</dd>
              <dt>Mitglieder · Platzhalter</dt>
            </div>
            <div>
              <dd>1.900&nbsp;km</dd>
              <dt>Gemeinsam gegangen · Platzhalter</dt>
            </div>
          </dl>
        )
      }
    </div>
    <div class="hero__hint" data-hero-hint aria-hidden="true">
      <span>Scroll</span><span class="hero__hint-line"></span>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 220vh;
    background: var(--color-night);
  }

  .hero__anchor {
    position: absolute;
    top: 0;
  }

  .hero__sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
  }

  .hero__media {
    position: absolute;
    inset: 0;
  }

  .hero__media-bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(105deg, var(--color-night-mid) 0%, var(--color-night-soft) 45%, var(--color-forest) 100%);
  }

  .hero__media-note {
    position: absolute;
    top: 96px;
    right: 48px;
    margin: 0;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cream-55);
    pointer-events: none;
    text-align: right;
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(10, 20, 31, 0.82) 0%,
      rgba(10, 20, 31, 0.25) 45%,
      rgba(10, 20, 31, 0.35) 100%
    );
    pointer-events: none;
  }

  .hero__content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--pad-x) 84px;
    pointer-events: none;
  }

  .hero__kicker {
    color: var(--color-lime);
  }

  h1 {
    margin: 20px 0 0;
    font-size: clamp(48px, 8.2vw, 142px);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.03em;
    max-width: 14ch;
    text-wrap: balance;
  }

  .hero__lead {
    margin: 24px 0 0;
    font-size: clamp(16px, 1.3vw, 19px);
    line-height: 1.6;
    color: var(--cream-80);
    max-width: 52ch;
  }

  .hero__ctas {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 36px;
    pointer-events: auto;
  }

  .hero__stats {
    display: flex;
    gap: 36px;
    margin: 44px 0 0;
    padding-top: 24px;
    border-top: 1px solid var(--cream-line);
    max-width: 560px;
    flex-wrap: wrap;
  }

  .hero__stats dd {
    margin: 0;
    font-size: 26px;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .hero__stats dt {
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cream-55);
    margin-top: 4px;
  }

  .hero__hint {
    position: absolute;
    right: 48px;
    bottom: 40px;
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(242, 238, 228, 0.6);
    pointer-events: none;
  }

  .hero__hint-line {
    display: block;
    width: 1px;
    height: 36px;
    background: rgba(242, 238, 228, 0.4);
  }

  @media (max-height: 720px) {
    h1 {
      font-size: clamp(34px, 5.6vw, 60px);
    }

    .hero__content {
      padding-bottom: 36px;
    }

    .hero__stats,
    .hero__hint {
      display: none;
    }

    .hero__ctas {
      margin-top: 22px;
    }
  }

  /* Mobil: keine lange Pinning-Strecke, Hero ist ein normaler Screen */
  @media (max-width: 899px) {
    .hero {
      height: auto;
    }

    .hero__sticky {
      position: relative;
      height: 100svh;
    }

    .hero__content {
      padding: 0 24px 72px;
    }

    h1 {
      font-size: clamp(38px, 10.5vw, 54px);
    }

    .hero__ctas {
      flex-direction: column;
      align-items: stretch;
    }

    .hero__hint {
      display: none;
    }
  }
</style>
