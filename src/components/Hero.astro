---
import Media from './Media.astro';
import Kicker from './Kicker.astro';
import SunArc from './SunArc.astro';
import { stats } from '../config/site';

/**
 * Kennzahlen werden nur gerendert, wenn echte Werte konfiguriert sind.
 * Ist nichts hinterlegt, entfällt der Block komplett.
 */
const statItems = [
  stats.memberCount != null
    ? { value: `${stats.memberCount.toLocaleString('de-DE')}+`, label: 'Mitglieder' }
    : null,
  stats.kilometersTogether != null
    ? {
        value: `${stats.kilometersTogether.toLocaleString('de-DE')}\u00a0km`,
        label: 'Gemeinsam gegangen',
      }
    : null,
].filter((s): s is { value: string; label: string } => s !== null);
---

<section id="hero" class="hero" aria-label="Intro">
  <span id="top" class="hero__anchor" aria-hidden="true"></span>
  <div class="hero__sticky">
    <div class="hero__media" data-hero-media>
      <Media
        class="hero__media-img"
        name="hero"
        alt="Bonner Skyline am Rhein vor dem Siebengebirge bei Nacht"
        eager
      />
      <div class="hero__scrim" data-hero-scrim></div>
    </div>

    <div class="hero__content" data-hero-content>
      <Kicker class="hero__kicker" animated>Hiking Club · Bonn</Kicker>
      <h1>From Beethoven&rsquo;s City to the&nbsp;Trails</h1>
      <p class="hero__lead">
        Der offene Hiking Club aus Bonn. Gemeinsam wandern, neue Leute kennenlernen und Wege rund
        um Rhein und Siebengebirge entdecken.
      </p>

      <div class="hero__ctas">
        <a class="btn btn--primary" href="#touren">Nächste Tour ansehen</a>
        <a class="btn btn--ghost" href="#regionen">Wo wir laufen</a>
      </div>

      <SunArc />

      {
        statItems.length > 0 && (
          <dl class="hero__stats">
            {statItems.map((s) => (
              <div>
                <dd>{s.value}</dd>
                <dt>{s.label}</dt>
              </div>
            ))}
          </dl>
        )
      }
    </div>

    <div class="hero__hint" data-hero-hint aria-hidden="true">
      <span>Scroll</span>
      <span class="hero__hint-line"></span>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 170vh;
    background: var(--color-night);
  }

  .hero__anchor {
    position: absolute;
    top: 0;
  }

  .hero__sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
  }

  .hero__media,
  .hero__media-img {
    position: absolute;
    inset: 0;
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(70% 55% at 50% 88%, var(--sky-tint) 0%, transparent 70%),
      radial-gradient(50% 40% at 85% 15%, var(--sky-tint-2) 0%, transparent 70%),
      linear-gradient(
        to top,
        rgba(4, 9, 16, 0.9) 0%,
        rgba(4, 9, 16, 0.35) 45%,
        rgba(4, 9, 16, 0.55) 100%
      );
    pointer-events: none;
    transition: background 2s ease;
  }

  .hero__content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--pad-x) 84px;
    pointer-events: none;
  }

  .hero__kicker {
    color: var(--color-lime);
  }

  h1 {
    margin: 20px 0 0;
    max-width: 14ch;
    font-size: clamp(48px, 8.2vw, 142px);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .hero__lead {
    margin: 24px 0 0;
    max-width: 52ch;
    font-size: clamp(16px, 1.3vw, 19px);
    line-height: 1.6;
    color: var(--cream-80);
  }

  .hero__ctas {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 36px;
    pointer-events: auto;
  }

  .hero__stats {
    display: flex;
    flex-wrap: wrap;
    gap: 36px;
    max-width: 560px;
    margin: 44px 0 0;
    padding-top: 24px;
    border-top: 1px solid var(--cream-line);
  }

  .hero__stats dd {
    margin: 0;
    color: var(--color-lime);
    font-size: 26px;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .hero__stats dt {
    margin-top: 4px;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cream-55);
  }

  .hero__content :global(.arc) {
    margin-top: 40px;
    pointer-events: auto;
  }

  .hero__hint {
    position: absolute;
    right: 48px;
    bottom: 40px;
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(242, 238, 228, 0.6);
    pointer-events: none;
  }

  .hero__hint-line {
    display: block;
    width: 1px;
    height: 36px;
    background: rgba(242, 238, 228, 0.4);
  }

  @media (min-width: 1100px) {
    .hero__content :global(.arc) {
      position: absolute;
      right: var(--pad-x);
      bottom: 40px;
      margin-top: 0;
    }

    .hero__hint {
      right: auto;
      left: 48px;
    }
  }

  @media (max-height: 720px) {
    h1 {
      font-size: clamp(34px, 5.6vw, 60px);
    }

    .hero__content {
      padding-bottom: 36px;
    }

    .hero__stats,
    .hero__hint {
      display: none;
    }

    .hero__ctas {
      margin-top: 22px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero {
      height: auto;
    }

    .hero__sticky {
      position: relative;
      height: 100svh;
    }

    .hero__hint {
      display: none;
    }
  }

  @media (max-width: 899px) {
    .hero {
      height: auto;
    }

    .hero__sticky {
      position: relative;
      height: 100svh;
    }

    .hero__content {
      padding: 0 24px 72px;
    }

    h1 {
      font-size: clamp(38px, 10.5vw, 54px);
    }

    .hero__ctas {
      flex-direction: column;
      align-items: stretch;
    }

    .hero__hint {
      display: none;
    }
  }
</style>
